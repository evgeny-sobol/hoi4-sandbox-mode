# docs/gdd/Scenarios.md "Selection": pin-rule options for the scenario pick.
# has_game_rule needs a verbatim two-key block, hence raw inline.
sandbox_scenario_pin_is_axis:
  raw has_game_rule: { rule = sandbox_scenario option = sandbox_axis_expansion }
sandbox_scenario_pin_is_sov_south:
  raw has_game_rule: { rule = sandbox_scenario option = sandbox_sov_south }
sandbox_scenario_pin_is_japanese:
  raw has_game_rule: { rule = sandbox_scenario option = sandbox_japanese_expansion }
sandbox_scenario_pin_is_italian:
  raw has_game_rule: { rule = sandbox_scenario option = sandbox_italian_expansion }
sandbox_scenario_pin_is_eng_soviet:
  raw has_game_rule: { rule = sandbox_scenario option = sandbox_eng_soviet }
sandbox_scenario_pin_is_usa_warplan:
  raw has_game_rule: { rule = sandbox_scenario option = sandbox_usa_warplan }
