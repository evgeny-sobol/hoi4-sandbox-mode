is_sandbox_mode_on:
  has_global_flag(sandbox_mode_enabled)

can_PREV_get_wargoal_on_THIS:
  OR:
    is_friend_of_PREV(no)
    is_honored_leader(no)

has_same_ideology_as_PREV:
  custom_trigger_tooltip:
    tooltip(has_same_ideology_tt)
    OR:
      AND:
        has_government(democratic)
        PREV->has_government(democratic)
      AND:
        has_government(neutrality)
        PREV->has_government(neutrality)
      AND:
        has_government(communism)
        PREV->has_government(communism)
      AND:
        has_government(fascism)
        PREV->has_government(fascism)

has_enemy_ideology_with_FROM:
  OR:
    AND:
      has_government(communism)
      FROM->OR:
        has_government(fascism)
        has_government(democratic)
    AND:
      has_government(democratic)
      FROM->OR:
        has_government(communism)
        has_government(fascism)
    AND:
      has_government(fascism)
      FROM->OR:
        has_government(democratic)
        has_government(communism)

is_friend_of_PREV:
  $is_friend_of(PREV)

is_friend_of_ROOT:
  $is_friend_of(ROOT)

is_honored_leader:
  custom_override_tooltip:
    tooltip(LocKey_is_honored_leader_tt)
    has_country_leader_with_trait(honorable_leader | righteous_leader)

is_rival_of_PREV:
  $is_rival_of(PREV)

is_rival_of_ROOT:
  $is_rival_of(ROOT)
