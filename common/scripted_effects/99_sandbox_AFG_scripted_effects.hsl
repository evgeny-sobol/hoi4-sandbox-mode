update_AFG_national_focuses():
  for watcher in every_country().which(original_tag($AFG)):

    # Helper for (focus) AFG_proclaim_a_new_caliphate AI
    if not has_completed_focus(AFG_proclaim_a_new_caliphate):
      &AFG_proclaim_a_new_caliphate_targets[].clear()
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $PAL)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $ENG)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $ISR)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $LEB)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $SYR)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $SAU)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $OMA)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $IMO)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $YEM)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $FSA)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $KUW)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $EGY)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $LBA)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $ITA)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $FRA)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $ALG)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $TUN)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $RIF)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $MOR)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $SPR)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $POR)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $INS)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $MAL)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $PAK)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $BAN)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $KSH)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $SIK)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $AZR)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $PER)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $ALB)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $TAT)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $CRI)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $TUR)
      $add_country_to_targets(AFG_proclaim_a_new_caliphate_targets, $IRQ)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in AFG_proclaim_a_new_caliphate_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &AFG_proclaim_a_new_caliphate_antagonism = 1 - sum_f / n
      else:
        &AFG_proclaim_a_new_caliphate_antagonism = 1
