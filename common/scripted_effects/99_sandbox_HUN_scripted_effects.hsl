update_HUN_national_focuses():
  for watcher in every_country().which(original_tag($HUN)):

    if not has_completed_focus(HUN_take_austria_by_force):
      &HUN_take_austria_by_force_targets[].clear()
      $add_state_owner_to_targets(HUN_take_austria_by_force_targets, 4)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in HUN_take_austria_by_force_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &HUN_take_austria_by_force_antagonism = 1 - sum_f / n
      else:
        &HUN_take_austria_by_force_antagonism = 1

