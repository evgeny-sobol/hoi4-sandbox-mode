update_EST_national_focuses():
  for watcher in every_country().which(original_tag($EST)):

    if not has_completed_focus(EST_unite_karelia):
      &EST_unite_karelia_targets[].clear()
      $add_state_owner_to_targets(EST_unite_karelia_targets, 147)
      $add_state_owner_to_targets(EST_unite_karelia_targets, 216)
      $add_state_owner_to_targets(EST_unite_karelia_targets, 215)
      $add_state_owner_to_targets(EST_unite_karelia_targets, 146)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in EST_unite_karelia_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &EST_unite_karelia_antagonism = 1 - sum_f / n
      else:
        &EST_unite_karelia_antagonism = 1
