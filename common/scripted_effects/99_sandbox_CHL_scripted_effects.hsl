update_CHL_national_focuses():
  for watcher in every_country().which(original_tag($CHL)):

    if not has_completed_focus(CHL_taking_back_patagonia):
      &CHL_taking_back_patagonia_targets[].clear()
      $add_state_owner_to_targets(CHL_taking_back_patagonia_targets, 512)
      $add_state_owner_to_targets(CHL_taking_back_patagonia_targets, 955)
      $add_state_owner_to_targets(CHL_taking_back_patagonia_targets, 954)
      $add_state_owner_to_targets(CHL_taking_back_patagonia_targets, 953)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in CHL_taking_back_patagonia_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &CHL_taking_back_patagonia_antagonism = 1 - sum_f / n
      else:
        &CHL_taking_back_patagonia_antagonism = 1

    if not has_completed_focus(CHL_enter_patagonia):
      &CHL_enter_patagonia_targets[].clear()
      $add_state_owner_to_targets(CHL_enter_patagonia_targets, 512)
      $add_state_owner_to_targets(CHL_enter_patagonia_targets, 955)
      $add_state_owner_to_targets(CHL_enter_patagonia_targets, 954)
      $add_state_owner_to_targets(CHL_enter_patagonia_targets, 953)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in CHL_enter_patagonia_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &CHL_enter_patagonia_antagonism = 1 - sum_f / n
      else:
        &CHL_enter_patagonia_antagonism = 1
