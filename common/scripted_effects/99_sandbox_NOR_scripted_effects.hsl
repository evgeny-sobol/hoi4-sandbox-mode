      if n > 0:
        &NOR_bjarmeland_antagonism = 1 - sum_f / n
      else:
        &NOR_bjarmeland_antagonism = 1

    if not has_completed_focus(NOR_claims_on_scotland):
      &NOR_claims_on_scotland_targets[].clear()
      $add_state_owner_to_targets(NOR_claims_on_scotland_targets, 120)
      $add_state_owner_to_targets(NOR_claims_on_scotland_targets, 933)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in NOR_claims_on_scotland_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &NOR_claims_on_scotland_antagonism = 1 - sum_f / n
      else:
        &NOR_claims_on_scotland_antagonism = 1

    if not has_completed_focus(NOR_old_vinland):
      &NOR_old_vinland_targets[].clear()
      $add_state_owner_to_targets(NOR_old_vinland_targets, 331)
      $add_state_owner_to_targets(NOR_old_vinland_targets, 332)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in NOR_old_vinland_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
