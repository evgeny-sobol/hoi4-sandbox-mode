update_NOR_national_focuses():
  for watcher in every_country().which(original_tag($NOR)):

    if not has_completed_focus(NOR_swedish_claims):
      &NOR_swedish_claims_targets[].clear()
      $add_state_owner_to_targets(NOR_swedish_claims_targets, 916)
      $add_state_owner_to_targets(NOR_swedish_claims_targets, 917)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in NOR_swedish_claims_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &NOR_swedish_claims_antagonism = 1 - sum_f / n
      else:
        &NOR_swedish_claims_antagonism = 1

    if not has_completed_focus(NOR_bjarmeland):
      &NOR_bjarmeland_targets[].clear()
