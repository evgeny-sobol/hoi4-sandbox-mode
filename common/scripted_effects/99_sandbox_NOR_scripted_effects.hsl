      $add_state_owner_to_targets(NOR_bjarmeland_targets, 215)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in NOR_bjarmeland_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
