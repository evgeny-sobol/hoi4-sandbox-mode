update_POL_national_focuses():
  for watcher in every_country().which(original_tag($POL)):

    if not has_completed_focus(POL_support_monarchy_in_CZE):
      &POL_support_monarchy_in_CZE_targets[].clear()
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 664)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 69)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 972)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 70)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 71)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 72)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 73)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 74)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 75)
      $add_state_owner_to_targets(POL_support_monarchy_in_CZE_targets, 9)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in POL_support_monarchy_in_CZE_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &POL_support_monarchy_in_CZE_antagonism = 1 - sum_f / n
      else:
        &POL_support_monarchy_in_CZE_antagonism = 1

    if not has_completed_focus(POL_reclaim_west_slavia):
      &POL_reclaim_west_slavia_targets[].clear()
      $add_state_owner_to_targets(POL_reclaim_west_slavia_targets, 66)
      $add_state_owner_to_targets(POL_reclaim_west_slavia_targets, 67)
      $add_state_owner_to_targets(POL_reclaim_west_slavia_targets, 68)
      $add_state_owner_to_targets(POL_reclaim_west_slavia_targets, 63)
      $add_state_owner_to_targets(POL_reclaim_west_slavia_targets, 5)
      $add_state_owner_to_targets(POL_reclaim_west_slavia_targets, 763)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in POL_reclaim_west_slavia_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &POL_reclaim_west_slavia_antagonism = 1 - sum_f / n
      else:
        &POL_reclaim_west_slavia_antagonism = 1
