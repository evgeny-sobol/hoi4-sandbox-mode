initialize_country_for_sandbox_mode:
  raw resize_array: { rivals = 3 }
  random_list:
    25:
      rival_ideology = token:democratic
      add_ideas(anti_democratic_sentiments)
    25:
      rival_ideology = token:neutrality
      add_ideas(anti_monarchist_sentiments)
    25:
      rival_ideology = token:communism
      add_ideas(anti_communist_sentiments)
    25:
      rival_ideology = token:fascism
      add_ideas(anti_fascist_sentiments)
  initialize_new_country_leader()
  shuffle_political_party_popularities()
  for i in range(2):
    select_minor_rival()

initialize_new_country_leader():
  add_country_leader_trait(leader_personality)
  add_country_leader_trait(inglorious_leader)

  if has_government(democratic):
    _min_tyranny = -100
    _max_tyranny =  -49
    if has_country_leader_ideology(liberalism) or has_country_leader_ideology(socialism):
      _min_tyranny +=   0
      _max_tyranny += -30
    elif has_country_leader_ideology(conservatism) or has_country_leader_ideology(populism):
      _min_tyranny +=  25
      _max_tyranny +=  25

  elif has_government(neutrality):
    _min_tyranny = -25
    _max_tyranny =  26
    if has_country_leader_ideology(anarchism):
      _min_tyranny += -50
      _max_tyranny += -50
    elif has_country_leader_ideology(moderatism) or has_country_leader_ideology(centrism):
      _min_tyranny += -25
      _max_tyranny += -25
    elif has_country_leader_ideology(despotism) or has_country_leader_ideology(oligarchism):
      _min_tyranny +=  25
      _max_tyranny +=  25
    elif has_country_leader_ideology(japan_militarism_ideology):
      _min_tyranny +=  75
      _max_tyranny +=  75

  elif has_government(communism):
    _min_tyranny =  50
    _max_tyranny = 101
    if has_country_leader_ideology(anarchist_communism) or has_country_leader_ideology(buddhist_socialism):
      _min_tyranny += -125
      _max_tyranny += -125
    elif has_country_leader_ideology(marxism) or has_country_leader_ideology(leninism):
      _min_tyranny +=  -50
      _max_tyranny +=  -50
    elif has_country_leader_ideology(stalinism) or has_country_leader_ideology(anti_revisionism):
      _min_tyranny +=   30
      _max_tyranny +=    0

  elif has_government(fascism):
    _min_tyranny =  80
    _max_tyranny = 101

  raw set_variable_to_random: { var=tyranny min=_min_tyranny max=_max_tyranny integer=yes }
  tyranny = clamp(tyranny, -100, 100)
  raw set_variable_to_random: { var=honor min=-100 max=101 integer=yes }
  update_country_leader_traits()
  select_major_rival()

select_major_rival:
  if rivals[0] == 0:
    candidate_weights[].clear()
    get_sorted_scored_countries:
      scorer(major_rivals_scorer)
      array(candidates)
      scores(candidate_scores)

    sum = 1
    for val, _ in candidate_scores[]:
      sum += val
    raw set_variable_to_random: { var=dice min=0 max=sum integer=yes }

    raw resize_array: { candidate_weights = candidates^num }
    for val, idx in candidate_scores[]:
      break(_b)
      candidate_weights[idx] = sum
      sum -= val
      if dice > candidate_weights[idx]:
        find_idx = idx - 1
        find = candidates[find_idx]
        rivals[0] = find
        _b = 1

    candidates[].clear()
    candidate_scores[].clear()
    candidate_weights[].clear()
    sum = null
    dice = null
    find_idx = null
    find = null

select_minor_rival:
  if rivals[1] == 0 or rivals[2] == 0:
    get_sorted_scored_countries:
      scorer(minor_rivals_scorer)
      array(candidates)
      scores(candidate_scores)

    sum = 1
    for val, _ in candidate_scores[]:
      sum += val
    raw set_variable_to_random: { var=dice min=0 max=sum integer=yes }

    raw resize_array: { candidate_weights = candidates^num }
    for val, idx in candidate_scores[]:
      break(_b)
      candidate_weights[idx] = sum
      sum -= val
      if dice > candidate_weights[idx]:
        find_idx = idx - 1
        find = candidates[find_idx]
        if rivals[1] == 0:
          rivals[1] = find
          _b = 1
        elif rivals[2] == 0 and not find == rivals[1]:
          rivals[2] = find
          _b = 1

    candidates[].clear()
    candidate_scores[].clear()
    candidate_weights[].clear()
    sum = null
    dice = null
    find_idx = null
    find = null

shuffle_political_party_popularities:
  # Ideology of government will have slightly more popularity
  if has_government(democratic):
    $set_random_political_party_popularities(democratic, neutrality, communism, fascism)
  elif has_government(neutrality):
    $set_random_political_party_popularities(neutrality, democratic, communism, fascism)
  elif has_government(communism):
    $set_random_political_party_popularities(communism, democratic, neutrality, fascism)
  elif has_government(fascism):
    $set_random_political_party_popularities(fascism, democratic, neutrality, communism)

  # Rival Ideology will have less popularity
  match var:rival_ideology:
    case token:democratic:
      _pop = party_popularity@democratic
    case token:neutrality:
      _pop = party_popularity@neutrality
    case token:communism:
      _pop = party_popularity@communism
    case token:fascism:
      _pop = party_popularity@fascism
  _pop *= 0.5 * 100
  raw set_political_party: { ideology=var:rival_ideology popularity=_pop }

update_country_leader_traits:
  if not honor == prev_honor:
    if has_country_leader_with_trait(treacherous_leader):
      remove_country_leader_trait(treacherous_leader)
    elif has_country_leader_with_trait(dishonorable_leader):
      remove_country_leader_trait(dishonorable_leader)
    elif has_country_leader_with_trait(inglorious_leader):
      remove_country_leader_trait(inglorious_leader)
    elif has_country_leader_with_trait(honorable_leader):
      remove_country_leader_trait(honorable_leader)
    elif has_country_leader_with_trait(righteous_leader):
      remove_country_leader_trait(righteous_leader)

    if honor < -75:
      add_country_leader_trait(treacherous_leader)
    elif honor < -25:
      add_country_leader_trait(dishonorable_leader)
    elif honor < 25:
      add_country_leader_trait(inglorious_leader)
    elif honor < 75:
      add_country_leader_trait(honorable_leader)
    else:
      add_country_leader_trait(righteous_leader)

    for _target in every_other_country():
      raw remove_opinion_modifier: { target=ROOT modifier=treacherous_leader }
      raw remove_opinion_modifier: { target=ROOT modifier=dishonorable_leader }
      raw remove_opinion_modifier: { target=ROOT modifier=honorable_leader }
      raw remove_opinion_modifier: { target=ROOT modifier=righteous_leader }

      if ROOT.honor < -75:
        _target:
          raw add_opinion_modifier: { target=ROOT modifier=treacherous_leader }
      elif ROOT.honor < -25:
        _target:
          raw add_opinion_modifier: { target=ROOT modifier=dishonorable_leader }
      elif ROOT.honor < 25:
        pass
      elif ROOT.honor < 75:
        _target:
          raw add_opinion_modifier: { target=ROOT modifier=honorable_leader }
      else:
        _target:
          raw add_opinion_modifier: { target=ROOT modifier=righteous_leader }

update_honor_gain_monthly_factor:
  guaranting[].clear()
  na_pacts[].clear()
  for _target in every_other_country():
    if is_guaranteed_by(ROOT):
      ROOT.guaranting[].add(_target)
    if has_non_aggression_pact_with(ROOT):
      ROOT.na_pacts[].add(_target)
  honor_gain_monthly_factor = 0.20 * guaranting[].size() + 0.05 * na_pacts[].size()

update_tyranny_gain_monthly_factor:
  if has_offensive_war():
    tyranny_gain_monthly_factor = -0.25
  elif has_defensive_war():
    tyranny_gain_monthly_factor = 0.25
  else:
    tyranny_gain_monthly_factor = 0
