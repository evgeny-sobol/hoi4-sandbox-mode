enable_sandbox_mode:
  set_country_flag(sandbox_mode_enabled)
  honor_stat <- 0
  honor_gain_monthly_factor <- 0
  tyranny_stat <- 0
  tyranny_gain_monthly_factor <- 0

  if is_ai() or is_debug():
    set_variable_to_random(): { var=honor_stat min=-100 max=101 integer=yes }
    random_list:
      25:
        rival_ideology <- token:democratic
      25:
        rival_ideology <- token:neutrality
      25:
        rival_ideology <- token:communism
      25:
        rival_ideology <- token:fascism

shuffle_political_party_popularities:
  if is_sandbox_mode_on():
    # Ideology of government will have slightly more popularity
    if has_government(democratic):
      $set_random_political_party_popularities(democratic, neutrality, communism, fascism)
    elif has_government(neutrality):
      $set_random_political_party_popularities(neutrality, democratic, communism, fascism)
    elif has_government(communism):
      $set_random_political_party_popularities(communism, democratic, neutrality, fascism)
    elif has_government(fascism):
      $set_random_political_party_popularities(fascism, democratic, neutrality, communism)

    # Rival Ideology will have less popularity
    if var:rival_ideology == token:democratic:
      _pop <- party_popularity@democratic
    elif var:rival_ideology == token:neutrality:
      _pop <- party_popularity@neutrality
    elif var:rival_ideology == token:communism:
      _pop <- party_popularity@communism
    elif var:rival_ideology == token:fascism:
      _pop <- party_popularity@fascism
    # `_pop *= 0.75 * 100`, because `set_political_party` accepts numbers from 0 to 100
    _pop *= 75
    set_political_party(): { ideology=var:rival_ideology popularity=_pop }

    # Using popularity of political parties
    #   as weight factors when selecting national focuses
    ideology_factors[].clear()
    ideology_factors[].add(party_popularity@democratic)
    ideology_factors[].add(party_popularity@neutrality)
    ideology_factors[].add(party_popularity@communism)
    ideology_factors[].add(party_popularity@fascism)
    ideology_factors[].min(_pop, _)
    for v, i in ideology_factors[]:
      _factor <- v
      _factor /= _pop
      ideology_factors[i] <- _factor

    # Democratic government is less likely to be tyrannical
    #   than a fascist one; and vice versa. 
    if is_ai() or is_debug():
      _democratic <- ideology_factors[0] * ideology_factors[0]
      _neutrality <- ideology_factors[1] * ideology_factors[1]
      _communism  <- ideology_factors[2] * ideology_factors[2]
      _fascism    <- ideology_factors[3] * ideology_factors[3]
      random_list:
        _democratic:
          set_variable_to_random(): { var=tyranny_stat min=-100 max=-24 integer=yes }
        _neutrality:
          set_variable_to_random(): { var=tyranny_stat min=-25 max=51 integer=yes }
        _communism:
          set_variable_to_random(): { var=tyranny_stat min=25 max=101 integer=yes }
        _fascism:
          set_variable_to_random(): { var=tyranny_stat min=25 max=101 integer=yes }

update_country_leader_traits:
  if is_sandbox_mode_on():
    if not has_country_leader_with_trait(LT_personality):
      add_country_leader_trait(LT_personality)

    if has_country_leader_with_trait(LT_honor_treacherous):
      remove_country_leader_trait(LT_honor_treacherous)
    elif has_country_leader_with_trait(LT_honor_dishonorable):
      remove_country_leader_trait(LT_honor_dishonorable)
    elif has_country_leader_with_trait(LT_honor_inglorious):
      remove_country_leader_trait(LT_honor_inglorious)
    elif has_country_leader_with_trait(LT_honor_honorable):
      remove_country_leader_trait(LT_honor_honorable)
    elif has_country_leader_with_trait(LT_honor_righteous):
      remove_country_leader_trait(LT_honor_righteous)

    if honor_stat < -75:
      add_country_leader_trait(LT_honor_treacherous)
    elif honor_stat < -25:
      add_country_leader_trait(LT_honor_dishonorable)
    elif honor_stat < 25:
      add_country_leader_trait(LT_honor_inglorious)
    elif honor_stat < 75:
      add_country_leader_trait(LT_honor_honorable)
    else:
      add_country_leader_trait(LT_honor_righteous)
