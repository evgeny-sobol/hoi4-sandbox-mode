# Pattern A / on_daily skips have no vanilla effect to hook. Log the wait
# so a capped observer game is distinguishable from "MTTH has not rolled".
sandbox_log_waiting_cw_fuses():
  if sandbox_civil_war_ai_blocked():
    if original_tag($SPR) and not has_civil_war() and not has_global_flag(spanish_civil_war) and not has_global_flag(scw_over):
      $sandbox_log_cw_defer(spain)
    if original_tag($AST) and sandbox_ast_veterans_fuse_ready():
      $sandbox_log_cw_defer(on_daily_AST)

reset_tyranny_for_new_ruler():
  set_tyranny_range_from_government()
  sandbox_log_old = tyranny
  &prev_tyranny = 999
  &tyranny = randi(min_tyranny, max_tyranny)
  &tyranny = clamp(tyranny, -100, 100)
  sandbox_log_new = tyranny
  sandbox_log_delta = tyranny - sandbox_log_old
  sandbox_log_slot = -1
  sandbox_log_other = 0
  $sandbox_log(tyranny_civil_war)


update_tyranny_gain_monthly_factor():
  war_rate = 0
  if has_war():
    war_rate = 0.25
    for s in every_owned_state():
      if is_core_of(ROOT) and not is_controlled_by(ROOT):
        war_rate = 0.50
        break
  stability_rate = 0
  if $compare(has_stability, "<", 0.25):
    stability_rate = 0.25
  drift = clamp(tyranny_home - tyranny, -0.25, 0.25)
  &tyranny_war_rate = war_rate
  &tyranny_stability_rate = stability_rate
  &tyranny_gain_monthly_factor = war_rate + stability_rate + drift
  if is_sandbox_census_country():
    if tyranny_gain_monthly_factor != prev_tyranny_gain_monthly_factor:
      sandbox_log_old = prev_tyranny_gain_monthly_factor
      sandbox_log_new = tyranny_gain_monthly_factor
      sandbox_log_delta = tyranny_gain_monthly_factor - prev_tyranny_gain_monthly_factor
      sandbox_log_slot = -1
      sandbox_log_other = 0
      $sandbox_log(tyranny_factor_change)
    &prev_tyranny_gain_monthly_factor = tyranny_gain_monthly_factor


# Temps: rival_slot (0-2), rival_tag, rival_intensity (50 or 75).
set_rival():
  sandbox_log_old = 0
  sandbox_log_new = rival_intensity
  sandbox_log_delta = rival_intensity
  sandbox_log_slot = rival_slot
  sandbox_log_other = rival_tag
  $sandbox_log(rivals_set)
  &rivals[rival_slot] = rival_tag
  &rivalry[rival_slot] = rival_intensity
  # add/remove_opinion_modifier reject `target = var:x` (Malformed token):
  # enter the rival's scope and address it as PREV from our own.
  if country_exists(var:rival_tag):
    var:rival_tag:
      PREV:
        if rival_slot == 0:
          $add_opinion_modifier(PREV, leaders_rival)
        else:
          $add_opinion_modifier(PREV, national_rival)
  rival_intensity = 50


# Temp: rival_slot. Optional flag sandbox_clear_rival_no_cooldown skips
# former_rivals[] (ruler-change re-roll of slot 0).
clear_rival():
  if rivals[rival_slot] != 0:
    old_rival = rivals[rival_slot]
    sandbox_log_old = rivalry[rival_slot]
    sandbox_log_new = 0
    sandbox_log_delta = 0 - sandbox_log_old
    sandbox_log_slot = rival_slot
    sandbox_log_other = old_rival
    if has_country_flag(sandbox_clear_rival_no_cooldown):
      $sandbox_log(rivals_clear_reroll)
    elif sandbox_clear_kind == 1:
      $sandbox_log(rivals_clear_gone)
    elif sandbox_clear_kind == 2:
      $sandbox_log(rivals_clear_faction)
    elif sandbox_clear_kind == 3:
      $sandbox_log(rivals_clear_subject)
    elif sandbox_clear_kind == 4:
      $sandbox_log(rivals_clear_detente)
    elif sandbox_clear_kind == 6:
      $sandbox_log(rivals_clear_annex)
    elif sandbox_clear_kind == 7:
      $sandbox_log(rivals_clear_replace)
    else:
      $sandbox_log(rivals_clear)
    sandbox_clear_kind = 0
    if country_exists(var:old_rival):
      var:old_rival:
        PREV:
          if rival_slot == 0:
            $remove_opinion_modifier(PREV, leaders_rival)
          else:
            $remove_opinion_modifier(PREV, national_rival)
    if not has_country_flag(sandbox_clear_rival_no_cooldown):
      &former_rivals[].add(old_rival)
      &former_rivals_month[].add(months_elapsed)
    &rivals[rival_slot] = 0
    &rivalry[rival_slot] = 0


reroll_leader_rival():
  set_country_flag(sandbox_clear_rival_no_cooldown)
  rival_slot = 0
  clear_rival()
  clr_country_flag(sandbox_clear_rival_no_cooldown)
  select_major_rival()


# Temps: rival_tag, rivalry_delta. Applies to every slot holding the tag.
add_rivalry_vs():
  if rivals[0] == rival_tag:
    $add_rivalry(0, rivalry_delta)
  if rivals[1] == rival_tag:
    $add_rivalry(1, rivalry_delta)
  if rivals[2] == rival_tag:
    $add_rivalry(2, rivalry_delta)


# Temp: rival_tag (the country that declared war on us). National slots only.
become_event_rival():
  if rival_tag in rivals[]:
    pass
  elif rivals[1] == 0:
    rival_slot = 1
    rival_intensity = 75
    set_rival()
  elif rivals[2] == 0:
    rival_slot = 2
    rival_intensity = 75
    set_rival()
  else:
    lowest_slot = 1
    lowest_val = rivalry[1]
    if rivalry[2] < lowest_val:
      lowest_slot = 2
      lowest_val = rivalry[2]
    if lowest_val < 25:
      rival_slot = lowest_slot
      sandbox_clear_kind = 7
      clear_rival()
      rival_slot = lowest_slot
      rival_intensity = 75
      set_rival()


review_rivals():
  for i in range(3):
    if rivals[i] != 0:
      rival_tag = rivals[i]
      should_clear = 0
      sandbox_clear_kind = 0
      if not country_exists(var:rival_tag):
        should_clear = 1
        sandbox_clear_kind = 1
      elif is_in_faction_with(var:rival_tag):
        should_clear = 1
        sandbox_clear_kind = 2
      elif is_subject_of(var:rival_tag):
        should_clear = 1
        sandbox_clear_kind = 3
      else:
        var:rival_tag:
          if is_subject_of(PREV):
            PREV:
              should_clear = 1
              sandbox_clear_kind = 3
      if should_clear == 1:
        rival_slot = i
        clear_rival()


update_rivalry_monthly():
  for i in range(3):
    if rivals[i] != 0:
      rival_tag = rivals[i]
      if country_exists(var:rival_tag):
        delta = 0
        has_plus = 0
        if has_war_with(var:rival_tag):
          delta += 2
          has_plus = 1
        if any_owned_state->is_core_of(var:rival_tag):
          delta += 2
          has_plus = 1
        var:rival_tag:
          if any_owned_state->is_core_of(PREV):
            PREV:
              delta += 2
              has_plus = 1
          if has_enemy_ideology_with_PREV():
            PREV:
              delta += 1
              has_plus = 1
          elif has_government(PREV):
            PREV:
              delta -= 1
          if has_non_aggression_pact_with(PREV):
            PREV:
              delta -= 1
          # +1 once if the rival fights any friend of ours. ROOT is the country
          # (called from on_monthly only); avoids reading temps across scopes.
          if any_enemy_country->is_friend_of_ROOT():
            ROOT:
              delta += 1
              has_plus = 1
        if i == 0:
          if is_authoritarian_leader():
            delta += 1
            has_plus = 1
          elif is_liberal_leader():
            delta -= 1
        if has_plus == 0:
          delta -= 1
        $add_rivalry(i, delta)


fill_rival_vacancies():
  if rivals[0] == 0:
    roll = randi(1, 6)
    if roll == 1:
      select_major_rival()
  if rivals[1] == 0:
    roll = randi(1, 6)
    if roll == 1:
      select_minor_rival()
  if rivals[2] == 0:
    roll = randi(1, 6)
    if roll == 1:
      select_minor_rival()


expire_former_rivals():
  keep[].clear()
  keep_month[].clear()
  for v, idx in &former_rivals[]:
    m = former_rivals_month[idx]
    age = months_elapsed - m
    if age < 24:
      keep[].add(v)
      keep_month[].add(m)
    else:
      sandbox_log_other = v
      sandbox_log_old = 0
      sandbox_log_new = 0
      sandbox_log_delta = age
      sandbox_log_slot = -1
      $sandbox_log(rivals_cooldown_expire)
  &former_rivals[].clear()
  &former_rivals_month[].clear()
  for v, _ in keep[]:
    &former_rivals[].add(v)
  for v, _ in keep_month[]:
    &former_rivals_month[].add(v)


# ROOT = attacker, FROM = target.
apply_rivalry_on_declare_war():
  max_r = 0
  if rivals[0] == FROM:
    if rivalry[0] > max_r:
      max_r = rivalry[0]
  if rivals[1] == FROM:
    if rivalry[1] > max_r:
      max_r = rivalry[1]
  if rivals[2] == FROM:
    if rivalry[2] > max_r:
      max_r = rivalry[2]
  if max_r >= 50:
    add_war_support(0.05)
    sandbox_log_old = 0
    sandbox_log_new = 0.05
    sandbox_log_delta = 0.05
    sandbox_log_slot = -1
    sandbox_log_other = FROM
    $sandbox_log(rivals_war_support_declare)

  FROM:
    was_rival = 0
    if ROOT in rivals[]:
      was_rival = 1
    rival_tag = ROOT
    become_event_rival()
    if was_rival == 1:
      rivalry_delta = 25
      add_rivalry_vs()
    if ROOT in rivals[]:
      add_war_support(0.10)
      sandbox_log_old = 0
      sandbox_log_new = 0.10
      sandbox_log_delta = 0.10
      sandbox_log_slot = -1
      sandbox_log_other = ROOT
      $sandbox_log(rivals_war_support_attacked)

  for other in every_other_country():
    if not tag(FROM):
      if is_friend_of_FROM():
        if ROOT in rivals[]:
          rival_tag = ROOT
          rivalry_delta = 15
          add_rivalry_vs()


# ROOT = capitulating country, FROM = winner.
apply_rivalry_on_capitulation():
  FROM:
    rival_tag = ROOT
    rivalry_delta = -50
    add_rivalry_vs()
  was_rival = 0
  if FROM in rivals[]:
    was_rival = 1
  if was_rival == 1:
    rival_tag = FROM
    rivalry_delta = 25
    add_rivalry_vs()
  else:
    rival_tag = FROM
    become_event_rival()


clear_annexed_from_rivals():
  for cty in every_country():
    if FROM in rivals[]:
      if rivals[0] == FROM:
        rival_slot = 0
        sandbox_clear_kind = 6
        clear_rival()
      if rivals[1] == FROM:
        rival_slot = 1
        sandbox_clear_kind = 6
        clear_rival()
      if rivals[2] == FROM:
        rival_slot = 2
        sandbox_clear_kind = 6
        clear_rival()


# GER/SOV/ENG/USA/FRA/ITA/JAP/FIN/HUN once per month after drift/rivals.
sandbox_log_census():
  if is_sandbox_census_country():
    log("#sandbox [GetDateText] [THIS.GetTag] census honor=[?honor|.2] hfac=[?honor_gain_monthly_factor|.2] ob=[?honor_obligation_gain|.2] tyr=[?tyranny|.2] tfac=[?tyranny_gain_monthly_factor|.2] war=[?tyranny_war_rate|.2] stab=[?tyranny_stability_rate|.2] g=[?guaranting^num] jp=[?honor_justify_pulses] r0=[?rivals^0.GetTag]:[?rivalry^0|.0] r1=[?rivals^1.GetTag]:[?rivalry^1|.0] r2=[?rivals^2.GetTag]:[?rivalry^2|.0] cw=[?global.sandbox_civil_war_count|.0] t=[?months_elapsed] home=[?tyranny_home|.1]")
    if original_tag(GER):
      GER_sandbox_count_inner_circle_foci()
      $sandbox_log_ger_inner_circle_state(GER_inner_circle_census)
