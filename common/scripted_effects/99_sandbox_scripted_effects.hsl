initialize_country_for_sandbox_mode():
  &rivals[].resize(3)
  initialize_new_country_leader()
  shuffle_political_party_popularities()
  for i in range(2):
    select_minor_rival()


initialize_new_country_leader():
  add_country_leader_trait(leader_personality)
  add_country_leader_trait(inglorious_leader)

  if has_government(democratic):
    min_tyranny, max_tyranny = -100, -50
    if has_country_leader_ideology(liberalism | socialism):
      min_tyranny +=   0
      max_tyranny += -30
    elif has_country_leader_ideology(conservatism | populism):
      min_tyranny +=  25
      max_tyranny +=  25

  elif has_government(neutrality):
    min_tyranny, max_tyranny = -25, 25
    if has_country_leader_ideology(anarchism):
      min_tyranny += -50
      max_tyranny += -50
    elif has_country_leader_ideology(moderatism | centrism):
      min_tyranny += -25
      max_tyranny += -25
    elif has_country_leader_ideology(despotism | oligarchism):
      min_tyranny +=  25
      max_tyranny +=  25
    elif has_country_leader_ideology(japan_militarism_ideology):
      min_tyranny +=  75
      max_tyranny +=  75

  elif has_government(communism):
    min_tyranny, max_tyranny = 50, 100
    if has_country_leader_ideology(anarchist_communism | buddhist_socialism):
      min_tyranny += -125
      max_tyranny += -125
    elif has_country_leader_ideology(marxism | leninism):
      min_tyranny +=  -50
      max_tyranny +=  -50
    elif has_country_leader_ideology(stalinism | anti_revisionism):
      min_tyranny +=   30
      max_tyranny +=    0

  elif has_government(fascism):
    min_tyranny, max_tyranny = 80, 100

  &tyranny = randi(min_tyranny, max_tyranny)
  &tyranny = clamp(tyranny, -100, 100)
  &honor = randi(-100, 100)
  update_country_leader_traits()
  select_major_rival()


select_major_rival():
  if rivals[0] == 0:
    get_sorted_scored_countries(major_rivals_scorer, candidates[], scores[])
    sum = 0
    for v, _ in scores[]:
      sum += v
    dice = randi(0, sum)

    weights[].resize(candidates[].size())
    for v, idx in scores[]:
      weights[idx] = sum
      sum -= v
      if dice > weights[idx]:
        find_idx = idx - 1
        find = candidates[find_idx]
        &rivals[0] = find
        break


select_minor_rival():
  if rivals[1] == 0 or rivals[2] == 0:
    get_sorted_scored_countries(minor_rivals_scorer, candidates[], scores[])
    sum = 0
    for v, _ in scores[]:
      sum += v
    dice = randi(0, sum)

    weights[].resize(candidates[].size())
    for v, idx in scores[]:
      weights[idx] = sum
      sum -= v
      if dice > weights[idx]:
        find_idx = idx - 1
        find = candidates[find_idx]
        if rivals[1] == 0:
          &rivals[1] = find
          break
        elif rivals[2] == 0 and find != rivals[1]:
          &rivals[2] = find
          break


# Shuffles the order of political ideologies and assigns random popularities
# that always sum to 100. The current ruling ideology is forced to be first
# and is guaranteed to have strictly higher popularity than every other party.
# The remaining three ideologies are randomly ordered using Fisher-Yates.
# | Party        | Possible popularity |
# | ------------ | ------------------- |
# | Ruling party |               43-70 |
# | Challenger 1 |               15-24 |
# | Challenger 2 |               10-19 |
# | Challenger 3 |                5-14 |
shuffle_political_party_popularities():
  # Clear working arrays (important!)
  copy[].clear()
  parties[].clear()

  # Copy all ideology groups
  for v, _ in global.ideology_groups[]:
    copy[].add(v)

  # Remove the current ruling ideology - it will be placed first
  copy[].erase(current_party_ideology_group)

  # Shuffle the remaining ideologies with Fisher-Yates
  last = copy[].size() - 1
  for i in range(last, 0, -1):
    j = randi(0, i)
    temp = copy[i]
    copy[i] = copy[j]
    copy[j] = temp

  # Build the final list: current ideology + shuffled others
  parties[].add(current_party_ideology_group)
  for v, _ in copy[]:
    parties[].add(v)

  # Assign popularity to the three non-ruling parties.
  # Ranges decrease and are capped so the ruling party always gets more.
  budget = 100
  for i in range(3):
    idx = i + 1
    party = parties[idx]

    rand_min = 15 - i * 5 # 15, 10, 5
    rand_max = 24 - i * 5 # 24, 19, 14
    rand_pop = randi(rand_min, rand_max)

    $set_political_party(var:party, rand_pop)
    budget -= rand_pop

  # Remaining budget goes to the ruling party (always the largest)
  party = parties[0]
  $set_political_party(var:party, budget)


update_country_leader_traits():
  if honor != prev_honor:
    if has_country_leader_with_trait(treacherous_leader):
      remove_country_leader_trait(treacherous_leader)
    elif has_country_leader_with_trait(dishonorable_leader):
      remove_country_leader_trait(dishonorable_leader)
    elif has_country_leader_with_trait(inglorious_leader):
      remove_country_leader_trait(inglorious_leader)
    elif has_country_leader_with_trait(honorable_leader):
      remove_country_leader_trait(honorable_leader)
    elif has_country_leader_with_trait(righteous_leader):
      remove_country_leader_trait(righteous_leader)

    if honor < -75:
      add_country_leader_trait(treacherous_leader)
    elif honor < -25:
      add_country_leader_trait(dishonorable_leader)
    elif honor < 25:
      add_country_leader_trait(inglorious_leader)
    elif honor < 75:
      add_country_leader_trait(honorable_leader)
    else:
      add_country_leader_trait(righteous_leader)

    for other in every_other_country():
      $remove_opinion_modifier(ROOT, treacherous_leader)
      $remove_opinion_modifier(ROOT, dishonorable_leader)
      $remove_opinion_modifier(ROOT, honorable_leader)
      $remove_opinion_modifier(ROOT, righteous_leader)

      if ROOT.honor < -75:
        other->$add_opinion_modifier(ROOT, treacherous_leader)
      elif ROOT.honor < -25:
        other->$add_opinion_modifier(ROOT, dishonorable_leader)
      elif ROOT.honor < 25:
        pass
      elif ROOT.honor < 75:
        other->$add_opinion_modifier(ROOT, honorable_leader)
      else:
        other->$add_opinion_modifier(ROOT, righteous_leader)


update_honor_gain_monthly_factor():
  for other in every_other_country():
    if is_guaranteed_by(ROOT):
      ROOT.guaranting[].add(other)
    if has_non_aggression_pact_with(ROOT):
      ROOT.na_pacts[].add(other)
  &honor_gain_monthly_factor = 0.20 * guaranting[].size() + 0.05 * na_pacts[].size()


update_tyranny_gain_monthly_factor():
  if has_offensive_war():
    &tyranny_gain_monthly_factor = -0.25
  elif has_defensive_war():
    &tyranny_gain_monthly_factor = 0.25
  else:
    &tyranny_gain_monthly_factor = 0
