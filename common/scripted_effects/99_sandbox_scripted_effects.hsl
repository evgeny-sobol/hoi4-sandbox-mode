initialize_country_for_sandbox_mode:
  &rivals[].resize(3)
  random_list:
    25:
      &rival_ideology = token:democratic
      add_ideas(anti_democratic_sentiments)
    25:
      &rival_ideology = token:neutrality
      add_ideas(anti_monarchist_sentiments)
    25:
      &rival_ideology = token:communism
      add_ideas(anti_communist_sentiments)
    25:
      &rival_ideology = token:fascism
      add_ideas(anti_fascist_sentiments)
  initialize_new_country_leader()
  shuffle_political_party_popularities()
  for i in range(2):
    select_minor_rival()

initialize_new_country_leader():
  add_country_leader_trait(leader_personality)
  add_country_leader_trait(inglorious_leader)

  if has_government(democratic):
    min_tyranny = -100
    max_tyranny =  -50
    if has_country_leader_ideology(liberalism) or has_country_leader_ideology(socialism):
      min_tyranny +=   0
      max_tyranny += -30
    elif has_country_leader_ideology(conservatism) or has_country_leader_ideology(populism):
      min_tyranny +=  25
      max_tyranny +=  25

  elif has_government(neutrality):
    min_tyranny = -25
    max_tyranny =  25
    if has_country_leader_ideology(anarchism):
      min_tyranny += -50
      max_tyranny += -50
    elif has_country_leader_ideology(moderatism) or has_country_leader_ideology(centrism):
      min_tyranny += -25
      max_tyranny += -25
    elif has_country_leader_ideology(despotism) or has_country_leader_ideology(oligarchism):
      min_tyranny +=  25
      max_tyranny +=  25
    elif has_country_leader_ideology(japan_militarism_ideology):
      min_tyranny +=  75
      max_tyranny +=  75

  elif has_government(communism):
    min_tyranny =  50
    max_tyranny = 100
    if has_country_leader_ideology(anarchist_communism) or has_country_leader_ideology(buddhist_socialism):
      min_tyranny += -125
      max_tyranny += -125
    elif has_country_leader_ideology(marxism) or has_country_leader_ideology(leninism):
      min_tyranny +=  -50
      max_tyranny +=  -50
    elif has_country_leader_ideology(stalinism) or has_country_leader_ideology(anti_revisionism):
      min_tyranny +=   30
      max_tyranny +=    0

  elif has_government(fascism):
    min_tyranny =  80
    max_tyranny = 100

  &tyranny = randi(min_tyranny, max_tyranny)
  &tyranny = clamp(tyranny, -100, 100)
  &honor = randi(-100, 100)
  update_country_leader_traits()
  select_major_rival()

select_major_rival:
  if rivals[0] == 0:
    get_sorted_scored_countries_temp:
      scorer(major_rivals_scorer)
      array(candidates)
      scores(candidate_scores)

    sum = 0
    for v, _ in candidate_scores[]:
      sum += v
    dice = randi(0, sum)

    candidate_weights[].resize(candidates[].size())
    for v, idx in candidate_scores[]:
      break(b)
      candidate_weights[idx] = sum
      sum -= v
      if dice > candidate_weights[idx]:
        find_idx = idx - 1
        find = candidates[find_idx]
        &rivals[0] = find
        b = 1

select_minor_rival:
  if rivals[1] == 0 or rivals[2] == 0:
    get_sorted_scored_countries_temp:
      scorer(minor_rivals_scorer)
      array(candidates)
      scores(candidate_scores)

    sum = 0
    for v, _ in candidate_scores[]:
      sum += v
    dice = randi(0, sum)

    candidate_weights[].resize(candidates[].size())
    for v, idx in candidate_scores[]:
      break(b)
      candidate_weights[idx] = sum
      sum -= v
      if dice > candidate_weights[idx]:
        find_idx = idx - 1
        find = candidates[find_idx]
        if rivals[1] == 0:
          &rivals[1] = find
          b = 1
        elif rivals[2] == 0 and not find == rivals[1]:
          &rivals[2] = find
          b = 1

shuffle_political_party_popularities:
  for v, _ in global.ideology_groups[]:
    copy[].add(v)

  parties[].add(current_party_ideology_group)
  copy[].erase(current_party_ideology_group)
  for i in range(3):
    rand_ideology = copy[].rand()
    parties[].add(rand_ideology)
    copy[].erase(rand_ideology)

  budget = 100
  rand_min = 26
  rand_max = 30
  for party, idx in parties[]:
    rand_pop = randi(rand_min, rand_max)
    $set_political_party(var:party, rand_pop)
    budget -= rand_pop
    rand_min -= clamp(3 - idx, 0, 3)
    rand_max -= clamp(4 - idx, 0, 4)

  match var:rival_ideology:
    case token:democratic:
      pop = party_popularity@democratic
    case token:neutrality:
      pop = party_popularity@neutrality
    case token:communism:
      pop = party_popularity@communism
    case token:fascism:
      pop = party_popularity@fascism
  pop *= 0.66667 * 100
  $set_political_party(var:rival_ideology, pop)

update_country_leader_traits:
  if not honor == prev_honor:
    if has_country_leader_with_trait(treacherous_leader):
      remove_country_leader_trait(treacherous_leader)
    elif has_country_leader_with_trait(dishonorable_leader):
      remove_country_leader_trait(dishonorable_leader)
    elif has_country_leader_with_trait(inglorious_leader):
      remove_country_leader_trait(inglorious_leader)
    elif has_country_leader_with_trait(honorable_leader):
      remove_country_leader_trait(honorable_leader)
    elif has_country_leader_with_trait(righteous_leader):
      remove_country_leader_trait(righteous_leader)

    if honor < -75:
      add_country_leader_trait(treacherous_leader)
    elif honor < -25:
      add_country_leader_trait(dishonorable_leader)
    elif honor < 25:
      add_country_leader_trait(inglorious_leader)
    elif honor < 75:
      add_country_leader_trait(honorable_leader)
    else:
      add_country_leader_trait(righteous_leader)

    for other in every_other_country():
      $remove_opinion_modifier(ROOT, treacherous_leader)
      $remove_opinion_modifier(ROOT, dishonorable_leader)
      $remove_opinion_modifier(ROOT, honorable_leader)
      $remove_opinion_modifier(ROOT, righteous_leader)

      if ROOT.honor < -75:
        other:
          $add_opinion_modifier(ROOT, treacherous_leader)
      elif ROOT.honor < -25:
        other:
          $add_opinion_modifier(ROOT, dishonorable_leader)
      elif ROOT.honor < 25:
        pass
      elif ROOT.honor < 75:
        other:
          $add_opinion_modifier(ROOT, honorable_leader)
      else:
        other:
          $add_opinion_modifier(ROOT, righteous_leader)

update_honor_gain_monthly_factor:
  for other in every_other_country():
    if is_guaranteed_by(ROOT):
      ROOT.guaranting[].add(other)
    if has_non_aggression_pact_with(ROOT):
      ROOT.na_pacts[].add(other)
  &honor_gain_monthly_factor = 0.20 * guaranting[].size() + 0.05 * na_pacts[].size()

update_tyranny_gain_monthly_factor:
  if has_offensive_war():
    &tyranny_gain_monthly_factor = -0.25
  elif has_defensive_war():
    &tyranny_gain_monthly_factor = 0.25
  else:
    &tyranny_gain_monthly_factor = 0
