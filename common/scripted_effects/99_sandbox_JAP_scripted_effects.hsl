update_JAP_national_focuses():
  for watcher in every_country().which(original_tag($JAP)):

    # Helper for (focus) JAP_occupy_indochina `available` / AI
    if not has_completed_focus(JAP_occupy_indochina):
      &JAP_occupy_indochina_targets[].clear()
      $add_state_owner_to_targets(JAP_occupy_indochina_targets, 670)
      $add_state_owner_to_targets(JAP_occupy_indochina_targets, 286)
      $add_state_owner_to_targets(JAP_occupy_indochina_targets, 1017)
      $add_state_owner_to_targets(JAP_occupy_indochina_targets, 741)
      $add_state_owner_to_targets(JAP_occupy_indochina_targets, 728)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in JAP_occupy_indochina_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &JAP_occupy_indochina_antagonism = 1 - sum_f / n
      else:
        &JAP_occupy_indochina_antagonism = 1

    # Helper for (focus) JAP_democratic_war_with_china `available` / AI
    if not has_completed_focus(JAP_democratic_war_with_china):
      &JAP_democratic_war_with_china_targets[].clear()
      $add_state_owner_to_targets(JAP_democratic_war_with_china_targets, 613)
      unique_owners[].clear()
      sum_f = 0
      n = 0
      for owner, idx in JAP_democratic_war_with_china_targets[]:
        if owner not in unique_owners[]:
          unique_owners[].add(owner)
          if owner != THIS:
            n += 1
            var:owner:
              PREV.sum_f += clamp(PREV.opinion@THIS / 100, -1.0, 1.0)
      if n > 0:
        &JAP_democratic_war_with_china_antagonism = 1 - sum_f / n
      else:
        &JAP_democratic_war_with_china_antagonism = 1
