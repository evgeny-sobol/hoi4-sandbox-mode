          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, sov_gone)
      if country_exists(SOV) and not ENG->has_war_with(SOV):
        SOV:
          country_event:
            id(sandbox_monarchical_great_britain.2)
      if country_exists(IRE):
        IRE:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, ire_gone)
      if country_exists(IRE) and not ENG->has_war_with(IRE):
        IRE:
          country_event:
            id(sandbox_monarchical_great_britain.3)
    else:
      if country_exists(USA):
        USA:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, usa_gone)
      if country_exists(USA) and not ENG->has_war_with(USA):
        USA:
          country_event:
            id(sandbox_monarchical_great_britain.2)
      if country_exists(IRE):
        IRE:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, ire_gone)
      if country_exists(IRE) and not ENG->has_war_with(IRE):
        IRE:
          country_event:
            id(sandbox_monarchical_great_britain.3)
    ENG:
      sandbox_select_monarchical_great_britain_joiners()

# Crises phase for fascist_america: provocation lands on the aggressor's desk.
sandbox_fire_fascist_america_crises():
  if global.sandbox_scenario == 7 and global.sandbox_scenario_phase == 1:
    USA:
      if country_exists(CAN) and not USA->has_war_with(CAN):
        USA:
          country_event:
            id(sandbox_fascist_america.1)

# Peak phase for fascist_america: ultimatums to the chosen targets, then join offers.
sandbox_fire_fascist_america_peak():
  if global.sandbox_scenario == 7 and global.sandbox_scenario_phase == 2:
    if global.sandbox_target_variant == 0:
      if country_exists(CAN):
        CAN:
          $sandbox_log_target_status(USA)
      else:
        USA:
          $sandbox_log_sc(sc_target, can_gone)
      if country_exists(CAN) and not USA->has_war_with(CAN):
        CAN:
          country_event:
            id(sandbox_fascist_america.2)
      if country_exists(MEX):
        MEX:
          $sandbox_log_target_status(USA)
      else:
        USA:
          $sandbox_log_sc(sc_target, mex_gone)
      if country_exists(MEX) and not USA->has_war_with(MEX):
        MEX:
          country_event:
            id(sandbox_fascist_america.3)
    USA:
      sandbox_select_fascist_america_joiners()

