# docs/gdd/Scenarios.md: director skeleton for the vanilla mod. Pick runs
# once at on_startup in HAI scope; the ladder tick runs monthly.
# State (globals, all 0 until picked):
#   sandbox_scenario: 0 none, 1 nazi_germany, 2 fascist_italy, 3 militarist_japan, 4 soviet_west,
#     5 napoleonic_france, 6 usa_warplan (7 reserved)
#   sandbox_scenario_phase: 0 smolder, 1 crises, 2 peak, 3 ended
#   sandbox_scenario_pin: 0 random, 1 pinned to the picked arc
#   sandbox_derailed_arcs[]: ids that derailed this session

# Target variants for the active arc (docs/gdd/Scenarios Catalog.md). HSL
# cannot hold tags in variables, so the chosen pair is written into the
# persistent sandbox_targets[] array. Variant A is the historical default.
sandbox_set_targets():
  global.&sandbox_targets[].clear()
  if global.sandbox_scenario == 1:
    gen_nazi_germany_scenario_set_targets()
  if global.sandbox_scenario == 2:
    gen_fascist_italy_scenario_set_targets()
  if global.sandbox_scenario == 3:
    gen_militarist_japan_scenario_set_targets()
  if global.sandbox_scenario == 4:
    gen_soviet_west_scenario_set_targets()
  if global.sandbox_scenario == 5:
    gen_napoleonic_france_scenario_set_targets()
  if global.sandbox_scenario == 6:
    if global.sandbox_target_variant == 0:
      global.&sandbox_targets[].add(JAP)
    else:
      global.&sandbox_targets[].add(ENG)
      global.&sandbox_targets[].add(CAN)

# Hand-written arc hooks for the shared on_actions skeleton. The two
# generated hooks (wargoal_expire / justify) live in
# common/scripted_effects/99_sandbox_arc_hooks.hsl. The skeleton calls all
# four unconditionally, so both must exist even when empty.
sandbox_arc_on_weekly():
  pass

# The vanilla tick chain ends at USA; this mod has no extra host.
sandbox_arc_tick_hosts():
  pass

# Mod-specific mission ids for the shared weekly cap delay. The core loop
# (sandbox_delay_capped_cw_missions) keeps only ids that exist in vanilla;
# this mod has none to add (docs/gdd/Civil Wars.md).
sandbox_delay_capped_cw_missions_mod():
  pass

sandbox_pick_scenario():
  gen_nazi_germany_scenario_pin()
  gen_fascist_italy_scenario_pin()
  gen_militarist_japan_scenario_pin()
  gen_soviet_west_scenario_pin()
  gen_napoleonic_france_scenario_pin()
  if global.sandbox_scenario_pin == 0:
    # Random pick (default): equal roll over eligible arcs (aggressor exists).
    global.&sandbox_scenario_pin = 0
    eligible[].clear()
    gen_nazi_germany_scenario_eligible()
    gen_fascist_italy_scenario_eligible()
    gen_militarist_japan_scenario_eligible()
    gen_soviet_west_scenario_eligible()
    gen_napoleonic_france_scenario_eligible()
    if eligible[].size() == 0:
      global.&sandbox_scenario = 0
    else:
      eligible_max = eligible[].size() - 1
      roll = randi(0, eligible_max)
      global.&sandbox_scenario = eligible[roll]
  global.&sandbox_scenario_phase = 0
  global.&sandbox_scenario_civil_war_months = 0
  global.&sandbox_scenario_peak_months = 0
  global.&sandbox_scenario_arc_months = 0
  gen_nazi_germany_scenario_roll_variant()
  gen_fascist_italy_scenario_roll_variant()
  gen_militarist_japan_scenario_roll_variant()
  gen_soviet_west_scenario_roll_variant()
  gen_napoleonic_france_scenario_roll_variant()
  sandbox_set_targets()
  sandbox_seed_actors()
  gen_nazi_germany_scenario_pick_log()
  gen_fascist_italy_scenario_pick_log()
  gen_militarist_japan_scenario_pick_log()
  gen_soviet_west_scenario_pick_log()
  gen_napoleonic_france_scenario_pick_log()
  if global.sandbox_scenario == 6:
    $sandbox_log_sc(sc_pick, usa_warplan)
  $sandbox_log_sc(sc_phase, smolder)
  sandbox_scenario_log_variant()

# docs/gdd/Scenarios.md "Hooks and telemetry": the A/B roll is logged
# as its own line so a session's target set reads without digging.
sandbox_scenario_log_variant():
  gen_nazi_germany_scenario_log_variant()
  gen_fascist_italy_scenario_log_variant()
  gen_militarist_japan_scenario_log_variant()
  gen_soviet_west_scenario_log_variant()
  gen_napoleonic_france_scenario_log_variant()

# docs/gdd/Scenarios.md "Selection": repick after a derail on random.
sandbox_scenario_maybe_repick():
  if global.sandbox_scenario_pin == 0:
    global.&sandbox_derailed_arcs[].add(global.sandbox_scenario)
    for every_country():
      &scenario_enemies[].clear()
    eligible[].clear()
    if country_exists(GER) and 1 not in global.sandbox_derailed_arcs[]:
      eligible[].add(1)
    if country_exists(ITA) and 2 not in global.sandbox_derailed_arcs[]:
      eligible[].add(2)
    if country_exists(JAP) and 3 not in global.sandbox_derailed_arcs[]:
      eligible[].add(3)
    if country_exists(SOV) and 4 not in global.sandbox_derailed_arcs[]:
      eligible[].add(4)
    if country_exists(FRA) and 5 not in global.sandbox_derailed_arcs[]:
      eligible[].add(5)
    if eligible[].size() == 0:
      # Issue 32: a none_eligible repick is only sane when every aggressor is
      # really gone or already derailed. Record the inputs so the next
      # occurrence is readable instead of a mystery.
      if is_sandbox_mode_on() and has_global_flag(sandbox_log_scenarios):
        repick_ger = 0
        if country_exists(GER):
          repick_ger = 1
        repick_ita = 0
        if country_exists(ITA):
          repick_ita = 1
        repick_jap = 0
        if country_exists(JAP):
          repick_jap = 1
        repick_sov = 0
        if country_exists(SOV):
          repick_sov = 1
        log("#sandbox [GetDateText] [THIS.GetTag] sc_repick_detail none_eligible eligible=[?eligible^num|.0] derailed=[?global.sandbox_derailed_arcs^num|.0] ger=[?repick_ger|.0] ita=[?repick_ita|.0] jap=[?repick_jap|.0] sov=[?repick_sov|.0] sc=[?global.sandbox_scenario|.0] phase=[?global.sandbox_scenario_phase|.0] pin=[?global.sandbox_scenario_pin|.0] t=[?months_elapsed]")
      $sandbox_log_sc(sc_repick, none_eligible)
    else:
      # Roll like the initial pick (docs/gdd/Scenarios.md "Selection": random
      # repicks). Taking eligible[0] walked the arcs in ascending id order.
      repick_max = eligible[].size() - 1
      repick_roll = randi(0, repick_max)
      global.&sandbox_scenario = eligible[repick_roll]
      global.&sandbox_scenario_phase = 0
      global.&sandbox_scenario_civil_war_months = 0
      global.&sandbox_scenario_peak_months = 0
      global.&sandbox_scenario_arc_months = 0
      gen_nazi_germany_scenario_roll_variant()
      gen_fascist_italy_scenario_roll_variant()
      gen_militarist_japan_scenario_roll_variant()
      gen_soviet_west_scenario_roll_variant()
      gen_napoleonic_france_scenario_roll_variant()
      sandbox_set_targets()
      sandbox_seed_actors()
      if global.sandbox_scenario == 1:
        $sandbox_log_sc(sc_repick, nazi_germany)
        $sandbox_log_sc(sc_pick, nazi_germany)
      if global.sandbox_scenario == 2:
        $sandbox_log_sc(sc_repick, fascist_italy)
        $sandbox_log_sc(sc_pick, fascist_italy)
      if global.sandbox_scenario == 3:
        $sandbox_log_sc(sc_repick, militarist_japan)
        $sandbox_log_sc(sc_pick, militarist_japan)
      if global.sandbox_scenario == 4:
        $sandbox_log_sc(sc_repick, soviet_west)
        $sandbox_log_sc(sc_pick, soviet_west)
      if global.sandbox_scenario == 5:
        $sandbox_log_sc(sc_repick, napoleonic_france)
        $sandbox_log_sc(sc_pick, napoleonic_france)
      if global.sandbox_scenario == 6:
        $sandbox_log_sc(sc_repick, usa_warplan)
        $sandbox_log_sc(sc_pick, usa_warplan)
      $sandbox_log_sc(sc_phase, smolder)
      sandbox_scenario_log_variant()

# Shared seed for the active arc (docs/gdd/Scenarios.md "Levers"). Seeds
# the aggressor against its chosen sandbox_targets[] at 65 and records the
# enemies symmetrically. THIS is the aggressor.
sandbox_seed_actors():
  if global.sandbox_scenario == 1:
    gen_nazi_germany_scenario_seed()
  if global.sandbox_scenario == 2:
    gen_fascist_italy_scenario_seed()
  if global.sandbox_scenario == 3:
    gen_militarist_japan_scenario_seed()
  if global.sandbox_scenario == 4:
    gen_soviet_west_scenario_seed()
  if global.sandbox_scenario == 5:
    gen_napoleonic_france_scenario_seed()
  if global.sandbox_scenario == 6:
    USA:
      sandbox_seed_from_targets()

# Runs in the aggressor's scope. Each live target slot is seeded as a
# rival and both sides record scenario_enemies[]. Body lives in the shared
# engine (core/common/scripted_effects/99_sandbox_engine.hsl).

# Monthly ladder tick (docs/gdd/Scenarios.md "Lifecycle"). Thresholds are
# arc-relative (`sandbox_scenario_arc_months`): < 12 smolder, 12-23 crises,
# 24+ peak, counted from the arc's own pick, so a repick restarts the ladder
# instead of inheriting the session clock. A derail check runs first; a
# parked arc goes quiet.
sandbox_scenario_tick():
  if global.sandbox_scenario == 0:
    pass
  else:
    if global.sandbox_scenario_phase < 3:
      global.&sandbox_scenario_arc_months += 1
    sandbox_scenario_check_ignite_by_war()
    sandbox_scenario_check_derail()
  gen_nazi_germany_scenario_tick()
  gen_fascist_italy_scenario_tick()
  gen_militarist_japan_scenario_tick()
  gen_soviet_west_scenario_tick()
  gen_napoleonic_france_scenario_tick()
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase == 0 and global.sandbox_scenario_arc_months >= 12:
    global.&sandbox_scenario_phase = 1
    $sandbox_log_sc(sc_phase, crises)
    sandbox_fire_usa_warplan_crises()
  elif global.sandbox_scenario == 6 and global.sandbox_scenario_phase == 1 and global.sandbox_scenario_arc_months >= 24:
    global.&sandbox_scenario_phase = 2
    $sandbox_log_sc(sc_phase, peak)
    sandbox_fire_usa_warplan_peak()
  sandbox_scenario_s7_telemetry()

# Shared join-2.0 helper: industry snapshot for the scorer. Body lives in
# the shared engine (core/common/scripted_effects/99_sandbox_engine.hsl).

# Crises phase for nazi_germany: provocation lands on the aggressor's desk.
sandbox_fire_nazi_germany_crises():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 1:
    GER:
      if country_exists(CZE) and not GER->has_war_with(CZE):
        GER:
          country_event:
            id(sandbox_nazi_germany.1)

# Dead-target convention (issue 14): peak telemetry and the derail arm share one
# test, country_exists(<declared tag>). A dead slot logs <tag>_gone from the
# aggressor scope, never a substituted live tag; the derail arm fires on the
# same test in the same tick, so the two cannot disagree.
# Peak phase for nazi_germany: ultimatums to the chosen targets, then join offers.
sandbox_fire_nazi_germany_peak():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 2:
    if global.sandbox_target_variant == 0:
      if country_exists(CZE):
        CZE:
          $sandbox_log_target_status(GER)
      else:
        GER:
          $sandbox_log_sc(sc_target, cze_gone)
      if country_exists(CZE) and not GER->has_war_with(CZE):
        CZE:
          country_event:
            id(sandbox_nazi_germany.2)
      if country_exists(POL):
        POL:
          $sandbox_log_target_status(GER)
      else:
        GER:
          $sandbox_log_sc(sc_target, pol_gone)
      if country_exists(POL) and not GER->has_war_with(POL):
        POL:
          country_event:
            id(sandbox_nazi_germany.3)
    else:
      if country_exists(FRA):
        FRA:
          $sandbox_log_target_status(GER)
      else:
        GER:
          $sandbox_log_sc(sc_target, fra_gone)
      if country_exists(FRA) and not GER->has_war_with(FRA):
        FRA:
          country_event:
            id(sandbox_nazi_germany.2)
      if country_exists(ENG):
        ENG:
          $sandbox_log_target_status(GER)
      else:
        GER:
          $sandbox_log_sc(sc_target, eng_gone)
      if country_exists(ENG) and not GER->has_war_with(ENG):
        ENG:
          country_event:
            id(sandbox_nazi_germany.3)
    GER:
      sandbox_select_nazi_germany_joiners()

