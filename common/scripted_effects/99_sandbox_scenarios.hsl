# Join levers for usa_warplan: open-pool top-2 by scenario_join_scorer.
sandbox_select_usa_warplan_joiners():
  sandbox_snapshot_join_industry()
  get_sorted_scored_countries(scenario_join_scorer, scenario_join_candidates[], scenario_join_scores[])
  if scenario_join_scores[0] > 0:
    var:scenario_join_candidates[0]:
      country_event:
        id(sandbox_usa_warplan.4)
      $sandbox_log_sc(sc_offer, invited)
  if scenario_join_scores[1] > 0:
    var:scenario_join_candidates[1]:
      country_event:
        id(sandbox_usa_warplan.4)
      $sandbox_log_sc(sc_offer, invited)

# s7 diagnostic (read-only): monthly strength + wargoal snapshot.
sandbox_scenario_s7_telemetry():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase < 3:
    gen_nazi_germany_scenario_telemetry()
  if global.sandbox_scenario == 2 and global.sandbox_scenario_phase < 3:
    gen_fascist_italy_scenario_telemetry()
  if global.sandbox_scenario == 3 and global.sandbox_scenario_phase < 3:
    gen_militarist_japan_scenario_telemetry()
  if global.sandbox_scenario == 4 and global.sandbox_scenario_phase < 3:
    gen_soviet_west_scenario_telemetry()
  if global.sandbox_scenario == 5 and global.sandbox_scenario_phase < 3:
    gen_napoleonic_france_scenario_telemetry()
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase < 3:
    if global.sandbox_target_variant == 0:
      USA:
        sc_div = num_divisions
        sc_fab = num_of_factories
        $sandbox_log_sc_power()
      if country_exists(JAP):
        JAP:
          sc_div = num_divisions
          sc_fab = num_of_factories
          $sandbox_log_sc_power()
      USA:
        if has_wargoal_against(JAP) or is_justifying_wargoal_against(JAP):
          $sandbox_log_sc(sc_goal, usa_on_jap)
        if is_justifying_wargoal_against(JAP):
          $sandbox_log_sc(sc_justify, usa_on_jap)
    else:
      USA:
        sc_div = num_divisions
        sc_fab = num_of_factories
        $sandbox_log_sc_power()
      if country_exists(ENG):
        ENG:
          sc_div = num_divisions
          sc_fab = num_of_factories
          $sandbox_log_sc_power()
      if country_exists(CAN):
        CAN:
          sc_div = num_divisions
          sc_fab = num_of_factories
          $sandbox_log_sc_power()
      USA:
        if has_wargoal_against(ENG) or is_justifying_wargoal_against(ENG):
          $sandbox_log_sc(sc_goal, usa_on_eng)
        if is_justifying_wargoal_against(ENG):
          $sandbox_log_sc(sc_justify, usa_on_eng)
        if has_wargoal_against(CAN) or is_justifying_wargoal_against(CAN):
          $sandbox_log_sc(sc_goal, usa_on_can)
        if is_justifying_wargoal_against(CAN):
          $sandbox_log_sc(sc_justify, usa_on_can)

sandbox_log_scenario_success():
  if global.sandbox_scenario == 1:
    $sandbox_log_sc(sc_ignite, nazi_germany_war)
    $sandbox_log_sc(sc_success, nazi_germany_war)
    $sandbox_log_sc(sc_end, nazi_germany_war)
  elif global.sandbox_scenario == 2:
    $sandbox_log_sc(sc_ignite, fascist_italy_war)
    $sandbox_log_sc(sc_success, fascist_italy_war)
    $sandbox_log_sc(sc_end, fascist_italy_war)
