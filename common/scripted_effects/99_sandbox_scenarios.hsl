    FRA:
      sandbox_select_napoleonic_france_joiners()

# Crises phase for monarchical_great_britain: provocation lands on the aggressor's desk.
sandbox_fire_monarchical_great_britain_crises():
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase == 1:
    ENG:
      if country_exists(IRE) and not ENG->has_war_with(IRE):
        ENG:
          country_event:
            id(sandbox_monarchical_great_britain.1)

# Peak phase for monarchical_great_britain: ultimatums to the chosen targets, then join offers.
sandbox_fire_monarchical_great_britain_peak():
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase == 2:
    if global.sandbox_target_variant == 0:
      if country_exists(ITA):
        ITA:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, ita_gone)
      if country_exists(ITA) and not ENG->has_war_with(ITA):
        ITA:
          country_event:
            id(sandbox_monarchical_great_britain.2)
      if country_exists(IRE):
        IRE:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, ire_gone)
      if country_exists(IRE) and not ENG->has_war_with(IRE):
        IRE:
          country_event:
            id(sandbox_monarchical_great_britain.3)
    elif global.sandbox_target_variant == 1:
      if country_exists(JAP):
        JAP:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, jap_gone)
      if country_exists(JAP) and not ENG->has_war_with(JAP):
        JAP:
          country_event:
            id(sandbox_monarchical_great_britain.2)
      if country_exists(IRE):
        IRE:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, ire_gone)
      if country_exists(IRE) and not ENG->has_war_with(IRE):
        IRE:
          country_event:
            id(sandbox_monarchical_great_britain.3)
    elif global.sandbox_target_variant == 2:
      if country_exists(SOV):
        SOV:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, sov_gone)
      if country_exists(SOV) and not ENG->has_war_with(SOV):
        SOV:
          country_event:
            id(sandbox_monarchical_great_britain.2)
      if country_exists(IRE):
        IRE:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, ire_gone)
      if country_exists(IRE) and not ENG->has_war_with(IRE):
        IRE:
          country_event:
            id(sandbox_monarchical_great_britain.3)
    else:
      if country_exists(USA):
        USA:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, usa_gone)
      if country_exists(USA) and not ENG->has_war_with(USA):
        USA:
          country_event:
            id(sandbox_monarchical_great_britain.2)
      if country_exists(IRE):
        IRE:
          $sandbox_log_target_status(ENG)
      else:
        ENG:
          $sandbox_log_sc(sc_target, ire_gone)
      if country_exists(IRE) and not ENG->has_war_with(IRE):
        IRE:
          country_event:
            id(sandbox_monarchical_great_britain.3)
    ENG:
      sandbox_select_monarchical_great_britain_joiners()

# s7 diagnostic (read-only): monthly strength + wargoal snapshot.
sandbox_scenario_s7_telemetry():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase < 3:
    gen_nazi_germany_scenario_telemetry()
  if global.sandbox_scenario == 2 and global.sandbox_scenario_phase < 3:
    gen_fascist_italy_scenario_telemetry()
  if global.sandbox_scenario == 3 and global.sandbox_scenario_phase < 3:
    gen_militarist_japan_scenario_telemetry()
  if global.sandbox_scenario == 4 and global.sandbox_scenario_phase < 3:
    gen_soviet_west_scenario_telemetry()
  if global.sandbox_scenario == 5 and global.sandbox_scenario_phase < 3:
    gen_napoleonic_france_scenario_telemetry()
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase < 3:
    gen_monarchical_great_britain_scenario_telemetry()

sandbox_log_scenario_success():
  # Issue 01: an arc can also ignite outside the monthly tick, from
  # on_declare_war, where there is no tick-start snapshot to compare against.
  # Mark the ended arc so the next tick's gate repicks it. Every caller sets
  # the phase to 3 first and is itself gated on phase < 3, so this flag is only
  # ever raised by a real ignition, never by a repeat or a parked arc.
  global.&sandbox_scenario_repick_pending = 1
  if global.sandbox_scenario == 1:
    $sandbox_log_sc(sc_ignite, nazi_germany_war)
    $sandbox_log_sc(sc_success, nazi_germany_war)
    $sandbox_log_sc(sc_end, nazi_germany_war)
  elif global.sandbox_scenario == 2:
    $sandbox_log_sc(sc_ignite, fascist_italy_war)
    $sandbox_log_sc(sc_success, fascist_italy_war)
    $sandbox_log_sc(sc_end, fascist_italy_war)
  elif global.sandbox_scenario == 3:
    $sandbox_log_sc(sc_ignite, militarist_japan_war)
    $sandbox_log_sc(sc_success, militarist_japan_war)
    $sandbox_log_sc(sc_end, militarist_japan_war)
  elif global.sandbox_scenario == 4:
    $sandbox_log_sc(sc_ignite, soviet_west_war)
    $sandbox_log_sc(sc_success, soviet_west_war)
    $sandbox_log_sc(sc_end, soviet_west_war)
  elif global.sandbox_scenario == 5:
    $sandbox_log_sc(sc_ignite, napoleonic_france_war)
    $sandbox_log_sc(sc_success, napoleonic_france_war)
    $sandbox_log_sc(sc_end, napoleonic_france_war)
  elif global.sandbox_scenario == 6:
    $sandbox_log_sc(sc_ignite, monarchical_great_britain_war)
    $sandbox_log_sc(sc_success, monarchical_great_britain_war)
    $sandbox_log_sc(sc_end, monarchical_great_britain_war)

