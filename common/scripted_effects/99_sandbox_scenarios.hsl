# docs/gdd/Scenarios.md "Lifecycle": derail dispatcher.
sandbox_scenario_check_derail():
  phase_before = global.sandbox_scenario_phase
  sandbox_scenario_check_civil_war_derail()
  $sandbox_check_peak_timeout()
  if global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 1:
    gen_nazi_germany_scenario_derail()
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 2:
    gen_fascist_italy_scenario_derail()
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 3:
    gen_militarist_japan_scenario_derail()
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 4:
    if not country_exists(ITA):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, ita_gone)
      $sandbox_log_sc(sc_end, ita_gone)
    elif ITA->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, ita_capitulated)
      $sandbox_log_sc(sc_end, ita_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail2(ITA, YUG, GRE)
      else:
        $sandbox_check_targets_derail2(ITA, FRA, ENG)
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 5:
    if not country_exists(ENG):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, eng_gone)
      $sandbox_log_sc(sc_end, eng_gone)
    elif ENG->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, eng_capitulated)
      $sandbox_log_sc(sc_end, eng_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail1(ENG, SOV)
      else:
        $sandbox_check_targets_derail1(ENG, SOV)
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 6:
    if not country_exists(USA):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, usa_gone)
      $sandbox_log_sc(sc_end, usa_gone)
    elif USA->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, usa_capitulated)
      $sandbox_log_sc(sc_end, usa_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail1(USA, JAP)
      else:
        $sandbox_check_targets_derail2(USA, ENG, CAN)
  if phase_before < 3 and global.sandbox_scenario_phase == 3:
    sandbox_scenario_maybe_repick()