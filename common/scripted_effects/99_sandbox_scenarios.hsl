# Crises phase for usa_warplan: provocation lands on the aggressor's desk.
sandbox_fire_usa_warplan_crises():
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase == 1:
    USA:
      if country_exists(JAP) and not USA->has_war_with(JAP):
        USA:
          country_event:
            id(sandbox_usa_warplan.1)

# Peak phase for usa_warplan: ultimatums to the chosen targets, then join offers.
sandbox_fire_usa_warplan_peak():
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase == 2:
    if global.sandbox_target_variant == a:
      if country_exists(JAP):
        JAP:
          $sandbox_log_target_status(USA)
      if country_exists(JAP) and not USA->has_war_with(JAP):
        JAP:
          country_event:
            id(sandbox_usa_warplan.2)
    else:
      if country_exists(ENG):
        ENG:
          $sandbox_log_target_status(USA)
      if country_exists(ENG) and not USA->has_war_with(ENG):
        ENG:
          country_event:
            id(sandbox_usa_warplan.2)
      if country_exists(CAN):
        CAN:
          $sandbox_log_target_status(USA)
      if country_exists(CAN) and not USA->has_war_with(CAN):
        CAN:
          country_event:
            id(sandbox_usa_warplan.3)
    USA:
      sandbox_select_usa_warplan_joiners()

# Join levers for usa_warplan: open-pool top-2 by scenario_join_scorer.
sandbox_select_usa_warplan_joiners():
  sandbox_snapshot_join_industry()
  get_sorted_scored_countries(scenario_join_scorer, scenario_join_candidates[], scenario_join_scores[])
  if scenario_join_scores[0] > 0:
    var:scenario_join_candidates[0]:
      country_event:
        id(sandbox_usa_warplan.4)
      $sandbox_log_sc(sc_offer, invited)
  if scenario_join_scores[1] > 0:
    var:scenario_join_candidates[1]:
      country_event:
        id(sandbox_usa_warplan.4)
      $sandbox_log_sc(sc_offer, invited)

