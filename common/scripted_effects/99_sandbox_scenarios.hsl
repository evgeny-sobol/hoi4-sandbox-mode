# docs/gdd/Scenarios.md: director skeleton for the vanilla mod. Pick runs
# once at on_startup in HAI scope; the ladder tick runs monthly.
# State (globals, all 0 until picked):
#   sandbox_scenario: 0 none, 1 axis, 2 sov_south, 3 japanese, 4 italian,
#     5 eng_soviet, 6 usa_warplan (7 reserved: France is not content-portable)
#   sandbox_scenario_phase: 0 smolder, 1 crises, 2 peak, 3 ended
#   sandbox_scenario_pin: 0 random, 1 pinned to the picked arc
#   sandbox_derailed_arcs[]: ids that derailed this session

# Target variants for the active arc (docs/gdd/Scenarios Catalog.md). HSL
# cannot hold tags in variables, so the chosen pair is written into the
# persistent sandbox_targets[] array. Variant A is the historical default.
sandbox_set_targets():
  global.&sandbox_targets[].clear()
  if global.sandbox_scenario == 1:
    if global.sandbox_target_variant == a:
      global.&sandbox_targets[].add(CZE)
      global.&sandbox_targets[].add(POL)
    else:
      global.&sandbox_targets[].add(FRA)
      global.&sandbox_targets[].add(ENG)
  if global.sandbox_scenario == 2:
    if global.sandbox_target_variant == a:
      global.&sandbox_targets[].add(TUR)
      global.&sandbox_targets[].add(IRQ)
      global.&sandbox_targets[].add(PER)
    else:
      global.&sandbox_targets[].add(PAK)
      global.&sandbox_targets[].add(RAJ)
      global.&sandbox_targets[].add(AFG)
  if global.sandbox_scenario == 3:
    if global.sandbox_target_variant == a:
      global.&sandbox_targets[].add(CHI)
      global.&sandbox_targets[].add(PHI)
    else:
      global.&sandbox_targets[].add(BRM)
      global.&sandbox_targets[].add(INS)
      global.&sandbox_targets[].add(MAL)
  if global.sandbox_scenario == 4:
    if global.sandbox_target_variant == a:
      global.&sandbox_targets[].add(YUG)
      global.&sandbox_targets[].add(GRE)
    else:
      global.&sandbox_targets[].add(FRA)
      global.&sandbox_targets[].add(ENG)
  if global.sandbox_scenario == 5:
    if global.sandbox_target_variant == a:
      global.&sandbox_targets[].add(SOV)
    else:
      global.&sandbox_targets[].add(SOV)
  if global.sandbox_scenario == 6:
    if global.sandbox_target_variant == a:
      global.&sandbox_targets[].add(JAP)
    else:
      global.&sandbox_targets[].add(ENG)
      global.&sandbox_targets[].add(CAN)

# Hand-written arc hooks for the shared on_actions skeleton. The two
# generated hooks (wargoal_expire / justify) live in
# common/scripted_effects/99_sandbox_arc_hooks.hsl. The skeleton calls all
# four unconditionally, so both must exist even when empty.
sandbox_arc_on_weekly():
  pass

# The vanilla tick chain ends at USA; this mod has no extra host.
sandbox_arc_tick_hosts():
  pass

sandbox_pick_scenario():
  if sandbox_scenario_pin_is_axis():
    global.&sandbox_scenario_pin = 1
    global.&sandbox_scenario = 1
  if sandbox_scenario_pin_is_sov_south():
    global.&sandbox_scenario_pin = 1
    global.&sandbox_scenario = 2
  if sandbox_scenario_pin_is_japanese():
    global.&sandbox_scenario_pin = 1
    global.&sandbox_scenario = 3
  if sandbox_scenario_pin_is_italian():
    global.&sandbox_scenario_pin = 1
    global.&sandbox_scenario = 4
  if sandbox_scenario_pin_is_eng_soviet():
    global.&sandbox_scenario_pin = 1
    global.&sandbox_scenario = 5
  if sandbox_scenario_pin_is_usa_warplan():
    global.&sandbox_scenario_pin = 1
    global.&sandbox_scenario = 6
  else:
    # Random pick (default): equal roll over eligible arcs (aggressor exists).
    global.&sandbox_scenario_pin = 0
    eligible[].clear()
    if country_exists(GER):
      eligible[].add(1)
    if country_exists(SOV):
      eligible[].add(2)
    if country_exists(JAP):
      eligible[].add(3)
    if country_exists(ITA):
      eligible[].add(4)
    if country_exists(ENG):
      eligible[].add(5)
    if country_exists(USA):
      eligible[].add(6)
    if eligible[].size() == 0:
      global.&sandbox_scenario = 0
    else:
      eligible_max = eligible[].size() - 1
      roll = randi(0, eligible_max)
      global.&sandbox_scenario = eligible[roll]
  global.&sandbox_scenario_phase = 0
  global.&sandbox_scenario_civil_war_months = 0
  global.&sandbox_scenario_peak_months = 0
  variant_roll = randi(0, 1)
  if variant_roll == 0:
    global.&sandbox_target_variant = a
  else:
    global.&sandbox_target_variant = b
  sandbox_set_targets()
  sandbox_seed_actors()
  if global.sandbox_scenario == 1:
    $sandbox_log_sc(sc_pick, axis)
  if global.sandbox_scenario == 2:
    $sandbox_log_sc(sc_pick, sov_south)
  if global.sandbox_scenario == 3:
    $sandbox_log_sc(sc_pick, japanese)
  if global.sandbox_scenario == 4:
    $sandbox_log_sc(sc_pick, italian)
  if global.sandbox_scenario == 5:
    $sandbox_log_sc(sc_pick, eng_soviet)
  if global.sandbox_scenario == 6:
    $sandbox_log_sc(sc_pick, usa_warplan)
  $sandbox_log_sc(sc_phase, smolder)
  sandbox_scenario_log_variant()

# docs/gdd/Scenarios.md "Hooks and telemetry": the A/B roll is logged
# as its own line so a session's target set reads without digging.
sandbox_scenario_log_variant():
  if global.sandbox_target_variant == a:
    $sandbox_log_sc(sc_variant, a)
  else:
    $sandbox_log_sc(sc_variant, b)

# docs/gdd/Scenarios.md "Selection": repick after a derail on random.
sandbox_scenario_maybe_repick():
  if global.sandbox_scenario_pin == 0:
    global.&sandbox_derailed_arcs[].add(global.sandbox_scenario)
    for every_country():
      &scenario_enemies[].clear()
    eligible[].clear()
    if country_exists(GER) and 1 not in global.sandbox_derailed_arcs[]:
      eligible[].add(1)
    if country_exists(SOV) and 2 not in global.sandbox_derailed_arcs[]:
      eligible[].add(2)
    if country_exists(JAP) and 3 not in global.sandbox_derailed_arcs[]:
      eligible[].add(3)
    if country_exists(ITA) and 4 not in global.sandbox_derailed_arcs[]:
      eligible[].add(4)
    if country_exists(ENG) and 5 not in global.sandbox_derailed_arcs[]:
      eligible[].add(5)
    if country_exists(USA) and 6 not in global.sandbox_derailed_arcs[]:
      eligible[].add(6)
    if eligible[].size() == 0:
      $sandbox_log_sc(sc_repick, none_eligible)
    else:
      global.&sandbox_scenario = eligible[0]
      global.&sandbox_scenario_phase = 0
      global.&sandbox_scenario_civil_war_months = 0
      global.&sandbox_scenario_peak_months = 0
      variant_roll = randi(0, 1)
      if variant_roll == 0:
        global.&sandbox_target_variant = a
      else:
        global.&sandbox_target_variant = b
      sandbox_set_targets()
      sandbox_seed_actors()
      if global.sandbox_scenario == 1:
        $sandbox_log_sc(sc_repick, axis)
        $sandbox_log_sc(sc_pick, axis)
      if global.sandbox_scenario == 2:
        $sandbox_log_sc(sc_repick, sov_south)
        $sandbox_log_sc(sc_pick, sov_south)
      if global.sandbox_scenario == 3:
        $sandbox_log_sc(sc_repick, japanese)
        $sandbox_log_sc(sc_pick, japanese)
      if global.sandbox_scenario == 4:
        $sandbox_log_sc(sc_repick, italian)
        $sandbox_log_sc(sc_pick, italian)
      if global.sandbox_scenario == 5:
        $sandbox_log_sc(sc_repick, eng_soviet)
        $sandbox_log_sc(sc_pick, eng_soviet)
      if global.sandbox_scenario == 6:
        $sandbox_log_sc(sc_repick, usa_warplan)
        $sandbox_log_sc(sc_pick, usa_warplan)
      $sandbox_log_sc(sc_phase, smolder)
      sandbox_scenario_log_variant()

# Shared seed for the active arc (docs/gdd/Scenarios.md "Levers"). Seeds
# the aggressor against its chosen sandbox_targets[] at 65 and records the
# enemies symmetrically. THIS is the aggressor.
sandbox_seed_actors():
  if global.sandbox_scenario == 1:
    GER:
      sandbox_seed_from_targets()
  if global.sandbox_scenario == 2:
    SOV:
      sandbox_seed_from_targets()
  if global.sandbox_scenario == 3:
    JAP:
      sandbox_seed_from_targets()
  if global.sandbox_scenario == 4:
    ITA:
      sandbox_seed_from_targets()
  if global.sandbox_scenario == 5:
    ENG:
      sandbox_seed_from_targets()
  if global.sandbox_scenario == 6:
    USA:
      sandbox_seed_from_targets()

# Runs in the aggressor's scope. Each live target slot is seeded as a
# rival and both sides record scenario_enemies[]. Body lives in the shared
# engine (core/common/scripted_effects/99_sandbox_engine.hsl).

# Monthly ladder tick (docs/gdd/Scenarios.md "Lifecycle"). Thresholds are
# HAI months_elapsed: < 12 smolder, 12-23 crises, 24+ peak. A derail check
# runs first; a parked arc goes quiet.
sandbox_scenario_tick():
  if global.sandbox_scenario == 0:
    pass
  else:
    sandbox_scenario_check_ignite_by_war()
    sandbox_scenario_check_derail()
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 0 and months_elapsed >= 12:
    global.&sandbox_scenario_phase = 1
    $sandbox_log_sc(sc_phase, crises)
    sandbox_fire_axis_crises()
  elif global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 1 and months_elapsed >= 24:
    global.&sandbox_scenario_phase = 2
    $sandbox_log_sc(sc_phase, peak)
    sandbox_fire_axis_peak()
  if global.sandbox_scenario == 2 and global.sandbox_scenario_phase == 0 and months_elapsed >= 12:
    global.&sandbox_scenario_phase = 1
    $sandbox_log_sc(sc_phase, crises)
    sandbox_fire_sov_south_crises()
  elif global.sandbox_scenario == 2 and global.sandbox_scenario_phase == 1 and months_elapsed >= 24:
    global.&sandbox_scenario_phase = 2
    $sandbox_log_sc(sc_phase, peak)
    sandbox_fire_sov_south_peak()
  if global.sandbox_scenario == 3 and global.sandbox_scenario_phase == 0 and months_elapsed >= 12:
    global.&sandbox_scenario_phase = 1
    $sandbox_log_sc(sc_phase, crises)
    sandbox_fire_japanese_crises()
  elif global.sandbox_scenario == 3 and global.sandbox_scenario_phase == 1 and months_elapsed >= 24:
    global.&sandbox_scenario_phase = 2
    $sandbox_log_sc(sc_phase, peak)
    sandbox_fire_japanese_peak()
  if global.sandbox_scenario == 4 and global.sandbox_scenario_phase == 0 and months_elapsed >= 12:
    global.&sandbox_scenario_phase = 1
    $sandbox_log_sc(sc_phase, crises)
    sandbox_fire_italian_crises()
  elif global.sandbox_scenario == 4 and global.sandbox_scenario_phase == 1 and months_elapsed >= 24:
    global.&sandbox_scenario_phase = 2
    $sandbox_log_sc(sc_phase, peak)
    sandbox_fire_italian_peak()
  if global.sandbox_scenario == 5 and global.sandbox_scenario_phase == 0 and months_elapsed >= 12:
    global.&sandbox_scenario_phase = 1
    $sandbox_log_sc(sc_phase, crises)
    sandbox_fire_eng_soviet_crises()
  elif global.sandbox_scenario == 5 and global.sandbox_scenario_phase == 1 and months_elapsed >= 24:
    global.&sandbox_scenario_phase = 2
    $sandbox_log_sc(sc_phase, peak)
    sandbox_fire_eng_soviet_peak()
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase == 0 and months_elapsed >= 12:
    global.&sandbox_scenario_phase = 1
    $sandbox_log_sc(sc_phase, crises)
    sandbox_fire_usa_warplan_crises()
  elif global.sandbox_scenario == 6 and global.sandbox_scenario_phase == 1 and months_elapsed >= 24:
    global.&sandbox_scenario_phase = 2
    $sandbox_log_sc(sc_phase, peak)
    sandbox_fire_usa_warplan_peak()
  sandbox_scenario_s7_telemetry()

# Shared join-2.0 helper: industry snapshot for the scorer. Body lives in
# the shared engine (core/common/scripted_effects/99_sandbox_engine.hsl).

# Crises phase for axis: provocation lands on the aggressor's desk.
sandbox_fire_axis_crises():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 1:
    GER:
      if country_exists(CZE) and not GER->has_war_with(CZE):
        GER:
          country_event:
            id(sandbox_axis.1)

# Peak phase for axis: ultimatums to the chosen targets, then join offers.
sandbox_fire_axis_peak():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 2:
    if global.sandbox_target_variant == a:
      if country_exists(CZE):
        CZE:
          $sandbox_log_target_status(GER)
      if country_exists(CZE) and not GER->has_war_with(CZE):
        CZE:
          country_event:
            id(sandbox_axis.2)
      if country_exists(POL):
        POL:
          $sandbox_log_target_status(GER)
      if country_exists(POL) and not GER->has_war_with(POL):
        POL:
          country_event:
            id(sandbox_axis.3)
    else:
      if country_exists(FRA):
        FRA:
          $sandbox_log_target_status(GER)
      if country_exists(FRA) and not GER->has_war_with(FRA):
        FRA:
          country_event:
            id(sandbox_axis.2)
      if country_exists(ENG):
        ENG:
          $sandbox_log_target_status(GER)
      if country_exists(ENG) and not GER->has_war_with(ENG):
        ENG:
          country_event:
            id(sandbox_axis.3)
    GER:
      sandbox_select_axis_joiners()

# Join levers for axis: open-pool top-2 by scenario_join_scorer.
sandbox_select_axis_joiners():
  sandbox_snapshot_join_industry()
  get_sorted_scored_countries(scenario_join_scorer, scenario_join_candidates[], scenario_join_scores[])
  if scenario_join_scores[0] > 0:
    var:scenario_join_candidates[0]:
      country_event:
        id(sandbox_axis.4)
      $sandbox_log_sc(sc_offer, invited)
  if scenario_join_scores[1] > 0:
    var:scenario_join_candidates[1]:
      country_event:
        id(sandbox_axis.4)
      $sandbox_log_sc(sc_offer, invited)

