# docs/gdd/Scenarios.md "Lifecycle": any war between declared scenario
# enemies ignites the arc (symmetric). Two paths share the log table:
# on_declare_war (direct) and the monthly ongoing-war sweep (indirect).
# Bodies live in the shared engine
# (core/common/scripted_effects/99_sandbox_engine.hsl).

sandbox_scenario_check_ignite_by_war():
  if global.sandbox_scenario > 0 and global.sandbox_scenario_phase < 3:
    if global.sandbox_scenario == 1:
      GER:
        sandbox_ignite_if_at_war()
    elif global.sandbox_scenario == 2:
      SOV:
        sandbox_ignite_if_at_war()
    elif global.sandbox_scenario == 3:
      JAP:
        sandbox_ignite_if_at_war()
    elif global.sandbox_scenario == 4:
      ITA:
        sandbox_ignite_if_at_war()
    elif global.sandbox_scenario == 5:
      ENG:
        sandbox_ignite_if_at_war()
    elif global.sandbox_scenario == 6:
      USA:
        sandbox_ignite_if_at_war()

# docs/gdd/Scenarios.md "Lifecycle": an aggressor stuck in a civil war
# cannot prosecute its arc, so the director derails after 12 months of it.
sandbox_scenario_check_civil_war_derail():
  if global.sandbox_scenario > 0 and global.sandbox_scenario_phase < 3:
    if global.sandbox_scenario == 1:
      GER:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 2:
      SOV:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 3:
      JAP:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 4:
      ITA:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 5:
      ENG:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 6:
      USA:
        $sandbox_check_aggressor_civil_war()

# docs/gdd/Scenarios.md "Lifecycle": derail dispatcher.
sandbox_scenario_check_derail():
  phase_before = global.sandbox_scenario_phase
  sandbox_scenario_check_civil_war_derail()
  $sandbox_check_peak_timeout()
  if global.sandbox_scenario == 1:
    if not country_exists(GER):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, ger_gone)
      $sandbox_log_sc(sc_end, ger_gone)
    elif GER->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, ger_capitulated)
      $sandbox_log_sc(sc_end, ger_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail2(GER, CZE, POL)
      else:
        $sandbox_check_targets_derail2(GER, FRA, ENG)
  elif global.sandbox_scenario == 2:
    if not country_exists(SOV):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, sov_gone)
      $sandbox_log_sc(sc_end, sov_gone)
    elif SOV->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, sov_capitulated)
      $sandbox_log_sc(sc_end, sov_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail3(SOV, TUR, IRQ, PER)
      else:
        $sandbox_check_targets_derail3(SOV, PAK, RAJ, AFG)
  elif global.sandbox_scenario == 3:
    if not country_exists(JAP):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, jap_gone)
      $sandbox_log_sc(sc_end, jap_gone)
    elif JAP->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, jap_capitulated)
      $sandbox_log_sc(sc_end, jap_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail2(JAP, CHI, PHI)
      else:
        $sandbox_check_targets_derail3(JAP, BRM, INS, MAL)
  elif global.sandbox_scenario == 4:
    if not country_exists(ITA):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, ita_gone)
      $sandbox_log_sc(sc_end, ita_gone)
    elif ITA->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, ita_capitulated)
      $sandbox_log_sc(sc_end, ita_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail2(ITA, YUG, GRE)
      else:
        $sandbox_check_targets_derail2(ITA, FRA, ENG)
  elif global.sandbox_scenario == 5:
    if not country_exists(ENG):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, eng_gone)
      $sandbox_log_sc(sc_end, eng_gone)
    elif ENG->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, eng_capitulated)
      $sandbox_log_sc(sc_end, eng_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail1(ENG, SOV)
      else:
        $sandbox_check_targets_derail1(ENG, SOV)
  elif global.sandbox_scenario == 6:
    if not country_exists(USA):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, usa_gone)
      $sandbox_log_sc(sc_end, usa_gone)
    elif USA->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, usa_capitulated)
      $sandbox_log_sc(sc_end, usa_capitulated)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail1(USA, JAP)
      else:
        $sandbox_check_targets_derail2(USA, ENG, CAN)
  if phase_before < 3 and global.sandbox_scenario_phase == 3:
    sandbox_scenario_maybe_repick()
