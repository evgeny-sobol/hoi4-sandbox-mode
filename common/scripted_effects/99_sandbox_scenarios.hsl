    elif global.sandbox_scenario == 6:
      ENG:
        sandbox_ignite_if_at_war()

# docs/gdd/Scenarios.md "Lifecycle": an aggressor stuck in a civil war
# cannot prosecute its arc, so the director derails after 12 months of it.
sandbox_scenario_check_civil_war_derail():
  if global.sandbox_scenario > 0 and global.sandbox_scenario_phase < 3:
    if global.sandbox_scenario == 1:
      GER:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 2:
      ITA:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 3:
      JAP:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 4:
      SOV:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 5:
      FRA:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 6:
      ENG:
        $sandbox_check_aggressor_civil_war()

# docs/gdd/Scenarios.md "Lifecycle": derail dispatcher.
# Peak-timeout triage (issue 05). Called from the shared sandbox_check_peak_timeout
# macro right after the generic sc_derail/sc_end pair, because that macro cannot
# scope into the aggressor: the arc -> tag mapping lives here. Logs the same pair
# again, once, with the state that separates the three ways a peak can time out:
#   ai=1              a human aggressor taking its time - design-compliant;
#   ai=0 wgo>0        AI holding war goals it never pressed - levers produced,
#                     nobody pulled;
#   ai=0 wgo=0        AI with no war goal at all - the ultimatums never landed.
# Same gate and field style as sc_goal/sc_power; ASCII only.
sandbox_log_peak_timeout_detail():
  if is_sandbox_mode_on() and has_global_flag(sandbox_log_scenarios):
    if global.sandbox_scenario == 1:
      GER:
        sandbox_log_peak_timeout_actor()
    elif global.sandbox_scenario == 2:
      ITA:
        sandbox_log_peak_timeout_actor()
    elif global.sandbox_scenario == 3:
      JAP:
        sandbox_log_peak_timeout_actor()
    elif global.sandbox_scenario == 4:
      SOV:
        sandbox_log_peak_timeout_actor()
    elif global.sandbox_scenario == 5:
      FRA:
        sandbox_log_peak_timeout_actor()
    elif global.sandbox_scenario == 6:
      ENG:
        sandbox_log_peak_timeout_actor()

# Runs in the aggressor's scope: THIS is the aggressor whose peak timed out.
sandbox_log_peak_timeout_actor():
  sc_ai = 0
  if is_ai(yes):
    sc_ai = 1
  sc_alive = 0
  sc_wgo = 0
  for i in range(4):
    t = global.sandbox_targets[i]
    if t != 0:
      if country_exists(var:t):
        sc_alive += 1
        if has_wargoal_against(var:t) or is_justifying_wargoal_against(var:t):
          sc_wgo += 1
  log("#sandbox [GetDateText] [THIS.GetTag] sc_derail peak_timeout ai=[?sc_ai] alive=[?sc_alive] wgo=[?sc_wgo] t0=[?global.sandbox_targets^0.GetTag] t1=[?global.sandbox_targets^1.GetTag] t2=[?global.sandbox_targets^2.GetTag] t3=[?global.sandbox_targets^3.GetTag] sc=[?global.sandbox_scenario|.0] phase=[?global.sandbox_scenario_phase|.0] pin=[?global.sandbox_scenario_pin|.0] t=[?months_elapsed] home=[?tyranny_home|.1]")
  log("#sandbox [GetDateText] [THIS.GetTag] sc_end peak_timeout ai=[?sc_ai] alive=[?sc_alive] wgo=[?sc_wgo] t0=[?global.sandbox_targets^0.GetTag] t1=[?global.sandbox_targets^1.GetTag] t2=[?global.sandbox_targets^2.GetTag] t3=[?global.sandbox_targets^3.GetTag] sc=[?global.sandbox_scenario|.0] phase=[?global.sandbox_scenario_phase|.0] pin=[?global.sandbox_scenario_pin|.0] t=[?months_elapsed] home=[?tyranny_home|.1]")


sandbox_scenario_check_derail():
  sandbox_scenario_check_civil_war_derail()
  $sandbox_check_peak_timeout()
  if global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 1:
    gen_nazi_germany_scenario_derail()
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 2:
    gen_fascist_italy_scenario_derail()
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 3:
    gen_militarist_japan_scenario_derail()
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 4:
    gen_soviet_west_scenario_derail()
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 5:
    gen_napoleonic_france_scenario_derail()
  elif global.sandbox_scenario_phase < 3 and global.sandbox_scenario == 6:
    gen_monarchical_great_britain_scenario_derail()
