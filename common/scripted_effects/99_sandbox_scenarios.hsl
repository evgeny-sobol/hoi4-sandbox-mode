    elif global.sandbox_scenario == 4:
      SOV:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 5:
      FRA:
        $sandbox_check_aggressor_civil_war()
    elif global.sandbox_scenario == 6:
