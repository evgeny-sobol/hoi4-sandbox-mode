      $add_state_owner_to_targets(GER_carve_up_czechoslovakia_targets, 75)
      $add_state_owner_to_targets(GER_carve_up_czechoslovakia_targets, 74)
      $add_state_owner_to_targets(GER_carve_up_czechoslovakia_targets, 972)
      unique_owners[].clear()
