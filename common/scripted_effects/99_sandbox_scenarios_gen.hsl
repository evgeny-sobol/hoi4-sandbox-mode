      $sandbox_log_sc_power()
    if country_exists(POL):
      POL:
        sc_div = num_divisions
        sc_fab = num_of_factories
        $sandbox_log_sc_power()
        if has_wargoal_against(SOV) or is_justifying_wargoal_against(SOV):
          $sandbox_log_sc(sc_goal, pol_on_sov)
    if country_exists(ROM):
      ROM:
        sc_div = num_divisions
        sc_fab = num_of_factories
        $sandbox_log_sc_power()
        if has_wargoal_against(SOV) or is_justifying_wargoal_against(SOV):
          $sandbox_log_sc(sc_goal, rom_on_sov)
    SOV:
      if has_wargoal_against(POL) or is_justifying_wargoal_against(POL):
        $sandbox_log_sc(sc_goal, sov_on_pol)
      if is_justifying_wargoal_against(POL):
        $sandbox_log_sc(sc_justify, sov_on_pol)
      if has_wargoal_against(ROM) or is_justifying_wargoal_against(ROM):
        $sandbox_log_sc(sc_goal, sov_on_rom)
      if is_justifying_wargoal_against(ROM):
        $sandbox_log_sc(sc_justify, sov_on_rom)

gen_soviet_west_scenario_derail():
  if not country_exists(SOV):
    global.&sandbox_scenario_phase = 3
    $sandbox_log_sc(sc_derail, sov_gone)
    $sandbox_log_sc(sc_end, sov_gone)
  elif SOV->has_capitulated():
    global.&sandbox_scenario_phase = 3
    $sandbox_log_sc(sc_derail, sov_capitulated)
    $sandbox_log_sc(sc_end, sov_capitulated)
  else:
    if global.sandbox_target_variant == 0:
      $sandbox_check_targets_derail3(SOV, EST, LAT, LIT)
    else:
      $sandbox_check_targets_derail2(SOV, POL, ROM)

gen_soviet_west_scenario_pin():
  if sandbox_scenario_pin_is_soviet_west():
    global.&sandbox_scenario_pin = 1
    global.&sandbox_scenario = 4

gen_soviet_west_scenario_eligible():
  if country_exists(SOV):
    eligible[].add(4)

gen_soviet_west_scenario_pick_log():
  if global.sandbox_scenario == 4:
    $sandbox_log_sc(sc_pick, soviet_west)
