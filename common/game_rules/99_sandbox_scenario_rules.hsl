# docs/gdd/Scenarios.md "Selection": pin rule for the scenario pick. Random
# (default) lets the director surprise; named options pin one arc.
sandbox_scenario:
  name("RULE_SANDBOX_SCENARIO")
  group("RULE_GROUP_SANDBOX")
  default:
    name(sandbox_random)
    text("RULE_OPTION_SANDBOX_RANDOM")
    desc("RULE_OPTION_SANDBOX_RANDOM_DESC")
  option:
    name(sandbox_nazi_germany)
    text("RULE_OPTION_SANDBOX_NAZI_GERMANY")
    desc("RULE_OPTION_SANDBOX_NAZI_GERMANY_DESC")
  option:
    name(fascist_italy)
    text("RULE_OPTION_SANDBOX_FASCIST_ITALY")
    desc("RULE_OPTION_SANDBOX_FASCIST_ITALY_DESC")
  option:
    name(militarist_japan)
    text("RULE_OPTION_SANDBOX_MILITARIST_JAPAN")
    desc("RULE_OPTION_SANDBOX_MILITARIST_JAPAN_DESC")
  option:
    name(soviet_west)
    text("RULE_OPTION_SANDBOX_SOVIET_WEST")
    desc("RULE_OPTION_SANDBOX_SOVIET_WEST_DESC")
  option:
    name(napoleonic_france)
    text("RULE_OPTION_SANDBOX_NAPOLEONIC_FRANCE")
    desc("RULE_OPTION_SANDBOX_NAPOLEONIC_FRANCE_DESC")
  option:
    name(monarchical_great_britain)
    text("RULE_OPTION_SANDBOX_MONARCHICAL_GREAT_BRITAIN")
    desc("RULE_OPTION_SANDBOX_MONARCHICAL_GREAT_BRITAIN_DESC")
