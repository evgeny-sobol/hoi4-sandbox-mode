# docs/gdd/Civil Wars.md Pattern D: the AI does not take the ignition decision
# while the cap is full. CHL_initiate_a_revolution runs start_civil_war.
CHL_the_hispanic_revolutions_decisions:
  CHL_initiate_a_revolution:
    ai_will_do:
      +modifier:
        $ai_civil_war_decision_cap()

# docs/gdd/Civil Wars.md activation gate + Pattern C: CHL_nacista_coup_attempt (978-day
# timeout) fires CHL_political_events.14, which starts the civil war. Gate the
# activation and keep the timeout in sandbox_delay_capped_cw_missions.
CHL_nacista_insurgency_decisions:
  CHL_nacista_coup_attempt:
    activation:
      sandbox_civil_war_ai_allowed()
