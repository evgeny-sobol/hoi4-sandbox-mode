DEN_avoid_axis_or_comintern:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)

DEN_avoid_allies:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)

DEN_buy_planes_from_netherlands_and_uk:
  enable:
    is_sandbox_mode_on(no)
  +abort:
    is_sandbox_mode_on(yes)

DEN_prioritize_artillery:
  enable:
    is_sandbox_mode_on(no)
  +abort:
    is_sandbox_mode_on(yes)
