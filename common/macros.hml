macro add_honor(val):
  if is_sandbox_mode_on():
    hidden_effect:
      honor += val
      raw clamp_variable: { var=honor min=-100 max=100 }
      update_country_leader_traits()
    custom_effect_tooltip:
      localization_key(LocKey_honor_change_tt)
      VALUE(val)

macro basic_modifier():
  factor(0)
  add(40)
  is_sandbox_mode_on()

macro ideology_factor(_ideology_):
  base(0)
  modifier:
    add(party_popularity@_ideology_)
    is_sandbox_mode_on()
  modifier:
    # Temporarily disable "rival ideology" mechanic
    add(0)
    var:rival_ideology == token:_ideology_
    is_sandbox_mode_on()
  modifier:
    factor(0)
    is_sandbox_mode_on(no)

macro opinion_factor(_target_):
  clamp(opinion@_target_ / 100 * -1, -1, 1)

macro set_random_political_party_popularities(A, B, C, D):
  pop_budget <- 70
  rand_pop <- 30
  set_political_party:
    ideology(A)
    popularity(rand_pop)

  raw set_variable_to_random: { var=rand_pop min=23 max=27 integer=yes }
  set_political_party:
    ideology(B)
    popularity(rand_pop)
  pop_budget -= rand_pop

  raw set_variable_to_random: { var=rand_pop min=21 max=24 integer=yes }
  set_political_party:
    ideology(C)
    popularity(rand_pop)
  pop_budget -= rand_pop

  set_political_party:
    ideology(D)
    popularity(pop_budget)
  rand_pop <- null
  pop_budget <- null
