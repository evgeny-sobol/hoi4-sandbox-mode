macro add_honor(_var_):
  hidden_effect:
    if not _var_ == 0:
      &prev_honor = honor
      &honor = clamp(honor + _var_, -100, 100)
      update_country_leader_traits()
  custom_effect_tooltip:
    localization_key(LocKey_honor_change_tt)
    VALUE(_var_)

macro add_tyranny(_var_):
  hidden_effect:
    if not _var_ == 0:
      &prev_tyranny = tyranny
      &tyranny = clamp(tyranny + _var_, -100, 100)
      update_country_leader_traits()
  custom_effect_tooltip:
    localization_key(LocKey_tyranny_change_tt)
    VALUE(_var_)

macro basic_modifier():
  factor(0)
  add(40)
  is_sandbox_mode_on()

macro ideology_factor(_ideology_):
  base(0)
  modifier:
    add(party_popularity@_ideology_)
    is_sandbox_mode_on()
  modifier:
    # Temporarily disable "rival ideology" mechanic
    add(0)
    var:rival_ideology == token:_ideology_
    is_sandbox_mode_on()
  modifier:
    factor(0)
    is_sandbox_mode_on(no)

macro opinion_factor(_target_):
  clamp(opinion@_target_ / 100 * -1, -1.0, 1.0)
