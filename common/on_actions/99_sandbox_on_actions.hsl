# Shared on_actions skeleton (docs/gdd/Scenarios.md "Hooks and telemetry").
# Per-mod arc hooks (implemented in each mod's 99_sandbox_scenarios.hsl):
#   sandbox_arc_on_weekly()              - extra weekly fuse retries (e.g. AFG BoP)
#   sandbox_arc_wargoal_expire_hook()    - sc_goal_end per-arc tag gates
#   sandbox_arc_justify_hook()           - sc_justify per-arc FROM gates
#   sandbox_arc_tick_hosts()             - extra monthly tick hosts past USA
#     (vanilla chain ends at USA; Rt56 appends FRA then HUN)
on_actions:
  on_startup:
    effect:
      HAI:
        log("#sandbox Mode Overhaul v0.2.0")
      if is_historical_focus_on(no):
        $HAI->set_global_flag(sandbox_mode_enabled)
        # Logging gates (docs/gdd/* "Hooks and telemetry"): each system logs only
        # while its gate is up. Scenarios is the only one on now; raise the
        # others from game.log by uncommenting the line below.
        HAI->$set_global_flag(sandbox_log_scenarios, 1)
        # HAI->$set_global_flag(sandbox_log_civil_wars, 1)
        # HAI->$set_global_flag(sandbox_log_honor, 1)
        # HAI->$set_global_flag(sandbox_log_national_focuses, 1)
        # HAI->$set_global_flag(sandbox_log_rivals, 1)
        # HAI->$set_global_flag(sandbox_log_tyranny, 1)
        HAI:
          log("#sandbox [GetDateText] [THIS.GetTag] sandbox_start historical=0")
        for every_country():
          initialize_country_for_sandbox_mode()
        # Scenario pick last: the init loop sets months_elapsed / tyranny_home
        # read by the sc_pick log line (docs/gdd/Scenarios.md "Selection").
        HAI:
          sandbox_pick_scenario()
      else:
        # Fires without is_sandbox_mode_on: historical game.log must still
        # show the mode, and must not contain cw_* lines afterwards.
        HAI:
          log("#sandbox [GetDateText] [THIS.GetTag] sandbox_start historical=1")

  on_weekly:
    effect:
      if is_sandbox_mode_on():
        # Countries created after startup (civil-war rebels, released nations)
        # never went through on_startup: initialise them on their first week.
        if not has_country_flag(sandbox_initialized):
          initialize_country_for_sandbox_mode()
        # One-shot guard set by on_release_as_free; must not outlive the week.
        clr_country_flag(sandbox_honor_skip_leave_faction)
        update_country_leader_traits()
        update_honor_gain_monthly_factor()
        update_tyranny_gain_monthly_factor()
        sandbox_delay_capped_cw_missions()
        sandbox_retry_ita_civil_war_fuse()
        sandbox_retry_eth_civil_war_fuse()
        sandbox_retry_sov_civil_war_fuse()
        sandbox_retry_gre_civil_war_fuse()
        sandbox_retry_per_civil_war_fuse()
        sandbox_retry_est_civil_war_fuse()
        sandbox_arc_on_weekly()
        sandbox_log_waiting_cw_fuses()
        # One rebuild + pulse per week (HAI is the sandbox flag holder).
        if tag(HAI):
          update_sandbox_civil_war_count()
          sandbox_cw_old = global.sandbox_civil_war_count
          $sandbox_log_cw_snapshot(cw_pulse)

  on_monthly:
    effect:
      if is_sandbox_mode_on():
        &months_elapsed += 1
        expire_dropped_obligations()
        expire_former_rivals()
        apply_honor_for_unmet_obligations()
        # "Once per war": forget answered calls once we are at peace.
        if not has_war():
          &honor_answered_call[].clear()
        $add_honor(honor_gain_monthly_factor)
        $add_tyranny(tyranny_gain_monthly_factor)
        review_rivals()
        update_rivalry_monthly()
        fill_rival_vacancies()
        sandbox_log_census()
        # Scenario ladder tick (docs/gdd/Scenarios.md "Lifecycle"). on_monthly
        # runs per country, so the tick fires in exactly one host per month:
        # HAI is the primary host with a fallback chain through the majors.
        if tag(HAI):
          sandbox_scenario_tick()
        elif not country_exists(HAI) and tag(GER):
          sandbox_scenario_tick()
        elif not country_exists(HAI) and not country_exists(GER) and tag(SOV):
          sandbox_scenario_tick()
        elif not country_exists(HAI) and not country_exists(GER) and not country_exists(SOV) and tag(JAP):
          sandbox_scenario_tick()
        elif not country_exists(HAI) and not country_exists(GER) and not country_exists(SOV) and not country_exists(JAP) and tag(ITA):
          sandbox_scenario_tick()
        elif not country_exists(HAI) and not country_exists(GER) and not country_exists(SOV) and not country_exists(JAP) and not country_exists(ITA) and tag(ENG):
          sandbox_scenario_tick()
        elif not country_exists(HAI) and not country_exists(GER) and not country_exists(SOV) and not country_exists(JAP) and not country_exists(ITA) and not country_exists(ENG) and tag(USA):
          sandbox_scenario_tick()
        else:
          sandbox_arc_tick_hosts()

  on_ruling_party_change:
    effect:
      if is_sandbox_mode_on():
        inherit_honor_on_ruling_party_change()

  # Civil-war splits and ideology swaps often install a new character without
  # initialize_new_country_leader (the initialized flag copies with the tag).
  on_government_change:
    effect:
      if is_sandbox_mode_on():
        update_country_leader_traits()

  # ROOT = winner. The rebel tag itself is initialised by the weekly guard above;
  # on_coup_succeeded is not used because its ROOT is the country the coup was
  # staged against, not the new regime.
  on_civil_war_end:
    effect:
      if is_sandbox_mode_on():
        reset_honor_for_new_ruler()
        # Rebuild the same day so an ignition slot opens without waiting a week.
        sandbox_log_other = FROM
        update_sandbox_civil_war_count()
        $sandbox_log_cw_war(cw_end)

  on_new_term_election:
    effect:
      if is_sandbox_mode_on():
        $add_tyranny(-5, tyranny_election)

  # ROOT = attacker, FROM = target
  on_declare_war:
    effect:
      if is_sandbox_mode_on():
        apply_honor_on_declare_war()
        apply_rivalry_on_declare_war()
        # Scenario ignition (docs/gdd/Scenarios.md "Lifecycle").
        sandbox_scenario_ignite()
        if has_civil_war() and FROM->has_civil_war():
          sandbox_log_other = FROM
          update_sandbox_civil_war_count()
          $sandbox_log_cw_war(cw_declare)

  # ROOT = justifier, FROM = target. The pulse is DAILY in vanilla, so the
  # -2 of the GDD is charged once per 30 pulses against a friend.
  # s7 diagnostic (read-only): a held-then-unused wargoal is the last-step
  # smoking gun. THIS-only: on_wargoal_expire scopes are undocumented.
  on_wargoal_expire:
    effect:
      if global.sandbox_scenario_phase < 3:
        sandbox_arc_wargoal_expire_hook()

  on_justifying_wargoal_pulse:
    effect:
      if is_sandbox_mode_on():
        if $is_friend_of(FROM):
          # Declared scenario enemies justify without the drip (docs/gdd/Scenarios.md).
          if FROM not in &scenario_enemies[]:
            &honor_justify_pulses += 1
            if honor_justify_pulses >= 30:
              &honor_justify_pulses = 0
              sandbox_log_other = FROM
              $add_honor(-2, honor_justify_friend)
        # s7 diagnostic (read-only): aggressor justifying on arc targets is
        # otherwise silent (Honor drips only vs friends). Daily while active.
        sandbox_arc_justify_hook()

  # ROOT = leaving country, FROM = faction leader
  on_leave_faction:
    effect:
      if is_sandbox_mode_on():
        if has_country_flag(sandbox_honor_skip_leave_faction):
          clr_country_flag(sandbox_honor_skip_leave_faction)
        elif is_subject_of(FROM) or FROM->has_capitulated():
          pass
        elif has_country_flag(expelled_by_leader):
          clr_country_flag(expelled_by_leader)
          FROM:
            sandbox_log_other = ROOT
            $add_honor(-15, honor_expel_member)
        elif FROM->has_war():
          sandbox_log_other = FROM
          $add_honor(-30, honor_leave_faction_war)
        else:
          sandbox_log_other = FROM
          $add_honor(-10, honor_leave_faction_peace)

  # ROOT = joining country, FROM = caller / country whose war was joined
  on_join_allies:
    effect:
      if is_sandbox_mode_on():
        if FROM not in &honor_answered_call[]:
          &honor_answered_call[].add(FROM)
          if FROM->is_guaranteed_by(ROOT):
            sandbox_log_other = FROM
            $add_honor(15, honor_join_allies_guarantee)
          else:
            sandbox_log_other = FROM
            $add_honor(10, honor_join_allies_call)
        review_rivals()
        FROM->review_rivals()

  # FROM is faction leader. Does not fire on add_to_faction.
  on_join_faction:
    effect:
      if is_sandbox_mode_on():
        review_rivals()
        FROM->review_rivals()

  # ROOT = nation being puppeted, FROM = overlord
  on_puppet:
    effect:
      if is_sandbox_mode_on():
        review_rivals()
        FROM->review_rivals()

  # ROOT is winner, FROM gets annexed
  on_annex:
    effect:
      if is_sandbox_mode_on():
        clear_annexed_from_rivals()

  # ROOT is capitulated country, FROM is winner
  on_capitulation:
    effect:
      if is_sandbox_mode_on():
        apply_rivalry_on_capitulation()

  # ROOT = released nation, FROM = releaser
  on_release_as_free:
    effect:
      if is_sandbox_mode_on():
        set_country_flag(sandbox_honor_skip_leave_faction)
        FROM:
          sandbox_log_other = ROOT
          $add_honor(5, honor_release)

  # ROOT = liberated nation, FROM = liberator
  on_liberate:
    effect:
      if is_sandbox_mode_on():
        FROM:
          sandbox_log_other = ROOT
          $add_honor(5, honor_liberate)
