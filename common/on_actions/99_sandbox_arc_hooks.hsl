# Per-mod arc hooks for the shared on_actions skeleton
# (core/common/on_actions/99_sandbox_core_on_actions.hsl).
# Regenerate with tools/extract_arc_hooks.py after editing the arc table.

sandbox_arc_on_weekly():
  pass

sandbox_arc_tick_hosts():
  pass

# sc_goal_end per-arc tag gates (runs under phase < 3).
sandbox_arc_wargoal_expire_hook():
  if global.sandbox_scenario == 1:
    if global.sandbox_target_variant == a:
      if tag(GER | CZE | POL):
        $sandbox_log_sc(sc_goal_end, goal_expired)
    else:
      if tag(GER | FRA | ENG):
        $sandbox_log_sc(sc_goal_end, goal_expired)
  if global.sandbox_scenario == 2:
    if global.sandbox_target_variant == a:
      if tag(SOV | TUR | IRQ | PER):
        $sandbox_log_sc(sc_goal_end, goal_expired)
    else:
      if tag(SOV | PAK | RAJ | AFG):
        $sandbox_log_sc(sc_goal_end, goal_expired)
  if global.sandbox_scenario == 3:
    if global.sandbox_target_variant == a:
      if tag(JAP | CHI | PHI):
        $sandbox_log_sc(sc_goal_end, goal_expired)
    else:
      if tag(JAP | BRM | INS | MAL):
        $sandbox_log_sc(sc_goal_end, goal_expired)
  if global.sandbox_scenario == 4:
    if global.sandbox_target_variant == a:
      if tag(ITA | YUG | GRE):
        $sandbox_log_sc(sc_goal_end, goal_expired)
    else:
      if tag(ITA | FRA | ENG):
        $sandbox_log_sc(sc_goal_end, goal_expired)
  if global.sandbox_scenario == 5:
    if global.sandbox_target_variant == a:
      if tag(ENG | SOV):
        $sandbox_log_sc(sc_goal_end, goal_expired)
    else:
      if tag(ENG | SOV):
        $sandbox_log_sc(sc_goal_end, goal_expired)
  if global.sandbox_scenario == 6:
    if global.sandbox_target_variant == a:
      if tag(USA | JAP):
        $sandbox_log_sc(sc_goal_end, goal_expired)
    else:
      if tag(USA | ENG | CAN):
        $sandbox_log_sc(sc_goal_end, goal_expired)

# sc_justify per-arc FROM gates (daily while active).
sandbox_arc_justify_hook():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase < 3 and tag(GER):
    if global.sandbox_target_variant == a:
      if FROM->tag(CZE):
        $sandbox_log_sc(sc_justify, ger_on_cze)
      if FROM->tag(POL):
        $sandbox_log_sc(sc_justify, ger_on_pol)
    else:
      if FROM->tag(FRA):
        $sandbox_log_sc(sc_justify, ger_on_fra)
      if FROM->tag(ENG):
        $sandbox_log_sc(sc_justify, ger_on_eng)
  if global.sandbox_scenario == 2 and global.sandbox_scenario_phase < 3 and tag(SOV):
    if global.sandbox_target_variant == a:
      if FROM->tag(TUR):
        $sandbox_log_sc(sc_justify, sov_on_tur)
      if FROM->tag(IRQ):
        $sandbox_log_sc(sc_justify, sov_on_irq)
      if FROM->tag(PER):
        $sandbox_log_sc(sc_justify, sov_on_per)
    else:
      if FROM->tag(PAK):
        $sandbox_log_sc(sc_justify, sov_on_pak)
      if FROM->tag(RAJ):
        $sandbox_log_sc(sc_justify, sov_on_raj)
      if FROM->tag(AFG):
        $sandbox_log_sc(sc_justify, sov_on_afg)
  if global.sandbox_scenario == 3 and global.sandbox_scenario_phase < 3 and tag(JAP):
    if global.sandbox_target_variant == a:
      if FROM->tag(CHI):
        $sandbox_log_sc(sc_justify, jap_on_chi)
      if FROM->tag(PHI):
        $sandbox_log_sc(sc_justify, jap_on_phi)
    else:
      if FROM->tag(BRM):
        $sandbox_log_sc(sc_justify, jap_on_brm)
      if FROM->tag(INS):
        $sandbox_log_sc(sc_justify, jap_on_ins)
      if FROM->tag(MAL):
        $sandbox_log_sc(sc_justify, jap_on_mal)
  if global.sandbox_scenario == 4 and global.sandbox_scenario_phase < 3 and tag(ITA):
    if global.sandbox_target_variant == a:
      if FROM->tag(YUG):
        $sandbox_log_sc(sc_justify, ita_on_yug)
      if FROM->tag(GRE):
        $sandbox_log_sc(sc_justify, ita_on_gre)
    else:
      if FROM->tag(FRA):
        $sandbox_log_sc(sc_justify, ita_on_fra)
      if FROM->tag(ENG):
        $sandbox_log_sc(sc_justify, ita_on_eng)
  if global.sandbox_scenario == 5 and global.sandbox_scenario_phase < 3 and tag(ENG):
    if global.sandbox_target_variant == a:
      if FROM->tag(SOV):
        $sandbox_log_sc(sc_justify, eng_on_sov)
    else:
      if FROM->tag(SOV):
        $sandbox_log_sc(sc_justify, eng_on_sov)
  if global.sandbox_scenario == 6 and global.sandbox_scenario_phase < 3 and tag(USA):
    if global.sandbox_target_variant == a:
      if FROM->tag(JAP):
        $sandbox_log_sc(sc_justify, usa_on_jap)
    else:
      if FROM->tag(ENG):
        $sandbox_log_sc(sc_justify, usa_on_eng)
      if FROM->tag(CAN):
        $sandbox_log_sc(sc_justify, usa_on_can)
