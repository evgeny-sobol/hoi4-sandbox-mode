  focus[id = IRQ_demand_palestine]:
    available:
      $PAL->can_PREV_get_wargoal_on_THIS()
      $ENG->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($PAL) + $opinion_factor($ENG)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $PAL->is_friend_of_PREV()
          $ENG->is_friend_of_PREV()

