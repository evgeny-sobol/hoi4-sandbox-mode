          $ITA->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($AUS) + $opinion_factor($ITA)) / 2
        factor(antagonism)
        is_sandbox_mode_on()

  focus[id = HUN_protect_austria]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
