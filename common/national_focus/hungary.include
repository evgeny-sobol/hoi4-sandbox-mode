focus_tree[id = hungarian_focus]:
  focus[id = HUN_balanced_budget]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = HUN_strengthen_the_monarchists]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_elect_a_king]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_invite_the_habsburg_prince]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        f = (mtth:monarchy_factor) / (2 * mtth:monarchy_factor + mtth:fascism_factor) * 3
        factor(f)
        is_sandbox_mode_on()

  focus[id = HUN_demand_a_referendum]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = HUN_take_austria_by_force]:
    available:
      var:HUN_take_austria_by_force_targets[0]->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        factor(HUN_take_austria_by_force_antagonism)
        is_sandbox_mode_on()

  focus[id = HUN_proclaim_the_restoration_of_austria_hungary]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_protect_czechoslovakia]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_claim_transylvania]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_march_to_the_shore]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_reclaim_venetia]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_claim_galicia]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_claim_the_bucovina]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_reclaim_the_empire]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_elect_a_democratic_king]:
    available:
      $SWE->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($SWE)

  focus[id = HUN_responsible_government]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $CZE->is_friend_of_PREV(no)
          $ROM->is_friend_of_PREV(no)
          $YUG->is_friend_of_PREV(no)
          $HUN->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($CZE) + $opinion_factor($ROM) + $opinion_factor($YUG) + $opinion_factor($HUN)) / 4
        factor(antagonism)
        is_sandbox_mode_on()

  focus[id = HUN_rapproachement_with_little_entente]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_join_allies]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = 1 + mtth:democracy_factor
        factor(f)
        is_sandbox_mode_on()

  focus[id = HUN_the_balkan_pact]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = HUN_an_unlikely_alliance]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_joint_oil_exploitation_company]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = HUN_elect_a_fascist_king]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        f = (mtth:fascism_factor + mtth:monarchy_factor) / (2 * mtth:monarchy_factor + mtth:fascism_factor) * 3
        factor(f)
        is_sandbox_mode_on()

  focus[id = HUN_economic_intervention]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
