  focus[id = POL_baltic_ultimatums]:
    available:
      $LAT->can_PREV_get_wargoal_on_THIS()
      $EST->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($LAT) + $opinion_factor($EST)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $LAT->is_friend_of_PREV()
