focus_tree[id = german_focus]:
#      TABLE OF CONTENTS
#I.    Crossroad 1
#II.   Crossroad 2
#III.  Crossroad 3
#IV.   Maneuver Warfare
#V.    Luftwaffe
#VI.   Kriegsmarine
#VII.  Economic Growth
#VIII. Democrats
#IX.   Monarchists
#X.    Weltpolitik
#XI.   Realpolitik
#XII.  Mitteleuropa
#XIII. Communists
#XIV.  Fascists
#XV.   Everything Else

#I. ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀█
#   █  ▄ █▀▀▄ █   █  ▀▀▄  ▀▀▄ █▀▀▄ █   █ █▀▀█ █  █       █
#    ▀▀  ▀  ▀  ▀▀▀  ▀▀▀  ▀▀▀  ▀  ▀  ▀▀▀  ▀  ▀ ▀▀▀        ▀
  focus[id = GER_remilitarize_the_rhineland]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        f = mtth:fascism_factor
        factor(f)
        is_sandbox_mode_on()

  focus[id = GER_oppose_hitler_ww]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()
      modifier:
        $crossroad_modifier(2)
      modifier:
        f = 1 - mtth:fascism_factor
        factor(f)
        is_sandbox_mode_on()

#II. ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀▀▀▄
#    █  ▄ █▀▀▄ █   █  ▀▀▄  ▀▀▄ █▀▀▄ █   █ █▀▀█ █  █      ▄▀▀
#     ▀▀  ▀  ▀  ▀▀▀  ▀▀▀  ▀▀▀  ▀  ▀  ▀▀▀  ▀  ▀ ▀▀▀       ▀▀▀▀
  focus[id = GER_start_the_proletarian_revolution]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)
      modifier:
        f = mtth:communism_factor /
          (mtth:democracy_factor + mtth:monarchy_factor + mtth:communism_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = GER_monarchist_sentiment]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)
      modifier:
        f = (mtth:democracy_factor + mtth:monarchy_factor) /
          (mtth:democracy_factor + mtth:monarchy_factor + mtth:communism_factor)
        factor(f)
        is_sandbox_mode_on()

#III. ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀▀▀▄
