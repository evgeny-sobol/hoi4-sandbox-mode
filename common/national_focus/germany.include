#     ▀▀▀▀  ▀▀   ▀▀▀  ▀   ▀  ▀▀▀  ▀   ▀ ▀  ▀▀        ▀▀▀  ▀  ▀  ▀▀▀   ▀ ▀    ▀   ▀  ▀
  focus[id = GER_prioritize_economic_growth]:
    +ai_will_do:
      modifier:
        factor(0)
        is_sandbox_mode_on()
      modifier:
        add(40)
        or:
          has_completed_focus(GER_re_establish_free_elections_ww)
          has_completed_focus(GER_return_of_the_kaiser)
        is_sandbox_mode_on()
      modifier:
        add(13.33)
        or:
          has_completed_focus(GER_start_the_proletarian_revolution)
        is_sandbox_mode_on()
      modifier:
        $root_modifier()
      modifier:
        $crossroad_modifier(2)

