  focus[id = GER_the_monarchy_compromise_ww]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)
      modifier:
        f = mtth:democracy_factor / (mtth:democracy_factor + mtth:monarchy_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = GER_revive_the_kaiserreich_ww]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)
      modifier:
        f = mtth:monarchy_factor / (mtth:democracy_factor + mtth:monarchy_factor)
        factor(f)
        is_sandbox_mode_on()

