focus_tree[id = french_focus]:
# ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀█
# █  ▄ █▀▀▄ █   █  ▀▀▄  ▀▀▄ █▀▀▄ █   █ █▀▀█ █  █       █
#  ▀▀  ▀  ▀  ▀▀▀  ▀▀▀  ▀▀▀  ▀  ▀  ▀▀▀  ▀  ▀ ▀▀▀        ▀
  focus[id = FRA_form_the_popular_front]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:democracy_factor + mtth:communism_factor) /
          (2 * mtth:democracy_factor + mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = FRA_revive_the_national_bloc]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:democracy_factor + mtth:monarchy_factor + mtth:fascism_factor) /
          (2 * mtth:democracy_factor + mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

# ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀▀▀▄
