focus_tree[id = french_focus]:

  focus[id = FRA_form_the_popular_front]:
    completion_reward:
      hidden_effect:
        SE_update_country_leader_traits()

  focus[id = FRA_national_regeneration]:
    completion_reward:
      hidden_effect:
        SE_update_country_leader_traits()

  focus[id = FRA_latin_entente]:
    completion_reward:
      +hidden_effect:
        SE_update_country_leader_traits()

  focus[id = FRA_towards_a_new_europe]:
    completion_reward:
      +hidden_effect:
        SE_update_country_leader_traits()

  focus[id = FRA_orleanist_restoration]:
    completion_reward:
      hidden_effect:
        SE_update_country_leader_traits()

  focus[id = FRA_the_legitimate_heir]:
    completion_reward:
      hidden_effect:
        SE_update_country_leader_traits()

  focus[id = FRA_proclaim_the_third_empire]:
    completion_reward:
      hidden_effect:
        SE_update_country_leader_traits()

  focus[id = FRA_intervention_in_greece]:
    available:
      GRE::can_PREV_get_wargoal_on_THIS()

  focus[id = FRA_the_natural_borders_of_france]:
    available:
      +OR:
        is_honored_leader(no)
        AND:
          BEL::is_friend_of_PREV(no)
          LUX::is_friend_of_PREV(no)
          HOL::is_friend_of_PREV(no)
          GER::is_friend_of_PREV(no)
    completion_reward:
      if is_sandbox_mode_on():
        custom_effect_tooltip(generic_skip_one_line_tt)
        $add_honor(-25)

  focus[id = FRA_split_belgium]:
    available:
      BEL::can_PREV_get_wargoal_on_THIS()

  focus[id = FRA_align_belgium]:
    available:
      BEL::can_PREV_get_wargoal_on_THIS()

  focus[id = FRA_bring_home_quebec]:
    available:
      CAN::can_PREV_get_wargoal_on_THIS()

  focus[id = FRA_dismantle_the_democracies]:
    available:
      GER::can_PREV_get_wargoal_on_THIS()

  focus[id = FRA_avenge_waterloo]:
    available:
      +OR:
        is_honored_leader(no)
        AND:
          BEL::is_friend_of_PREV(no)
          LUX::is_friend_of_PREV(no)
          HOL::is_friend_of_PREV(no)
          ENG::is_friend_of_PREV(no)
    completion_reward:
      if is_sandbox_mode_on():
        custom_effect_tooltip(generic_skip_one_line_tt)
        $add_honor(-25)

  focus[id = FRA_retribution_for_sedan]:
    available:
      GER::can_PREV_get_wargoal_on_THIS()

  focus[id = FRA_return_to_borodino]:
    available:
      SOV::can_PREV_get_wargoal_on_THIS()

