      +modifier:
        $ai_sandbox_modifier()

  focus[id = FRA_reconnect_to_the_balkans]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        cooperation = 1 + ($opinion_factor($CZE) + $opinion_factor($ROM)) / 2
        factor(cooperation)
        is_sandbox_mode_on()

  focus[id = FRA_pre_empt_the_fascist_attack]:
    available:
      $GER->can_PREV_get_wargoal_on_THIS()
      $ITA->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($GER) + $opinion_factor($ITA)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $GER->is_friend_of_PREV()
          $ITA->is_friend_of_PREV()

  focus[id = FRA_league_of_french_bolshevist_volunteers]:
