  focus[id = FRA_national_regeneration]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = mtth:fascism_factor / (mtth:monarchy_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = FRA_the_council_of_rambouillet]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = mtth:monarchy_factor / (mtth:monarchy_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

