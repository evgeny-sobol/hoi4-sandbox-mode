focus_tree[id = indian_focus]:
  focus[id = RAJ_provincial_elections]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()

  focus[id = RAJ_swaraj]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($ENG)
      +modifier:
        $ai_rivalry_modifier($ENG)
      +modifier:
        $ai_betrayal_modifier_vs($ENG)

  focus[id = RAJ_indian_national_congress]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($ENG)
      +modifier:
        $ai_rivalry_modifier($ENG)
      +modifier:
        $ai_betrayal_modifier_vs($ENG)

  focus[id = RAJ_quit_india_movement]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = RAJ_all_india_forward_bloc]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = RAJ_seek_help_from_soviet]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = RAJ_indian_peoples_army]:
    available:
      $not_rival_of_PREV($RAJ)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_cooperation_modifier($RAJ)
      +modifier:
        factor(0)
        $RAJ in rivals[]
        is_sandbox_mode_on()

  focus[id = RAJ_research_city_excursions]:
