  focus[id = political_effort]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()

  focus[id = collectivist_ethos]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:communism_factor + mtth:fascism_factor + mtth:monarchy_factor) / (mtth:communism_factor + mtth:fascism_factor + 2 * mtth:monarchy_factor + mtth:democracy_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = nationalism_focus]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:fascism_factor + mtth:monarchy_factor) / (mtth:fascism_factor + 2 * mtth:monarchy_factor + mtth:communism_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = internationalism_focus]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:communism_factor + mtth:monarchy_factor) / (mtth:fascism_factor + 2 * mtth:monarchy_factor + mtth:communism_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = liberty_ethos]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:democracy_factor + mtth:monarchy_factor) / (mtth:communism_factor + mtth:fascism_factor + 2 * mtth:monarchy_factor + mtth:democracy_factor) * 2
        factor(f)
        is_sandbox_mode_on()

