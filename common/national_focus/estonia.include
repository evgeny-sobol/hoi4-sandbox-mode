  focus[id = EST_beyond_the_baltic]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = 1 + mtth:democracy_factor
        factor(f)
        is_sandbox_mode_on()

