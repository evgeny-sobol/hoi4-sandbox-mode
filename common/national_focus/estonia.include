focus_tree[id = estonia_tree]:
  focus[id = EST_era_of_silence]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = EST_ismaaliit]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_establish_the_rahvuskogu]:
    ai_will_do:
      +modifier:
