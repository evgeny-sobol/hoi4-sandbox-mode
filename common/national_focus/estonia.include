      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = EST_march_on_talinn]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_glory_of_war]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_mobilize_the_vets]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_vapsid_youth]:
    ai_will_do:
