  focus[id = EST_anti_communist_militia]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:fascism_factor) / (2 * mtth:fascism_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = EST_reach_out_to_germany]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:fascism_factor) / (2 * mtth:fascism_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = EST_baltic_shield]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_join_the_axis]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_the_brotherhood]:
    available:
      $LIT->can_PREV_get_wargoal_on_THIS()
      $LAT->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($LIT) + $opinion_factor($LAT)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $LIT->is_friend_of_PREV()
          $LAT->is_friend_of_PREV()

  focus[id = EST_empower_finnish_militants]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_national_pride_in_finland]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_finno_estonian_supremacy_league]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:fascism_factor) / (2 * mtth:fascism_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = EST_unite_our_nations]:
    available:
      $FIN->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:fascism_factor) / (2 * mtth:fascism_factor) * 2
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($FIN)
      +modifier:
        $ai_betrayal_modifier_vs($FIN)

  focus[id = EST_sieze_swedish_assets]:
    available:
      $SWE->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($SWE)
      +modifier:
        $ai_betrayal_modifier_vs($SWE)

  focus[id = EST_secure_the_straits]:
    available:
      $DEN->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($DEN)
      +modifier:
        $ai_betrayal_modifier_vs($DEN)

  focus[id = EST_occupy_norway]:
    available:
      $NOR->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($NOR)
      +modifier:
        $ai_betrayal_modifier_vs($NOR)

  focus[id = EST_form_scandinavia]:
    available:
      $NOR->can_PREV_get_wargoal_on_THIS()
      $SWE->can_PREV_get_wargoal_on_THIS()
      $DEN->can_PREV_get_wargoal_on_THIS()
      $FIN->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($NOR) + $opinion_factor($SWE) + $opinion_factor($DEN) + $opinion_factor($FIN)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $NOR->is_friend_of_PREV()
          $SWE->is_friend_of_PREV()
          $DEN->is_friend_of_PREV()
          $FIN->is_friend_of_PREV()

  focus[id = EST_proclaim_finno_ugra]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = EST_unite_the_sami]:
    available:
      $NOR->can_PREV_get_wargoal_on_THIS()
      $SWE->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($NOR) + $opinion_factor($SWE)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $NOR->is_friend_of_PREV()
          $SWE->is_friend_of_PREV()

  focus[id = EST_unite_karelia]:
    available:
      var:EST_unite_karelia_targets[0]->can_PREV_get_wargoal_on_THIS()
      var:EST_unite_karelia_targets[1]->can_PREV_get_wargoal_on_THIS()
      var:EST_unite_karelia_targets[2]->can_PREV_get_wargoal_on_THIS()
      var:EST_unite_karelia_targets[3]->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        factor(EST_unite_karelia_antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        any_other_country:
          THIS in ROOT.EST_unite_karelia_targets[]
          is_friend_of_ROOT()

  focus[id = EST_unite_the_finnic_identity]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

