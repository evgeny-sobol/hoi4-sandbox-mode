  focus[id = HOL_cave_to_the_germans]:
    available:
      $HOL->can_PREV_get_wargoal_on_THIS()
      $INS->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($HOL) + $opinion_factor($INS)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $HOL->is_friend_of_PREV()
          $INS->is_friend_of_PREV()

