      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAN_reclaim_the_empire]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAN_assert_our_authority]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = MAN_offer_vassalization]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
