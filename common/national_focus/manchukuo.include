        $ai_sandbox_modifier()

  focus[id = MAN_assertiveness]:
    available:
      $MAN->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($MAN)
      +modifier:
