  focus[id = MAN_empower_the_legislative_council]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAN_five_people_armies]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAN_purge_the_general_affairs_council]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_high_tyranny_tilt()
    completion_reward:
      $add_tyranny(20)
    available:
      is_liberal_leader(no)

  focus[id = MAN_reform_the_civil_service]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAN_independence_war]:
    available:
      $JAP->can_PREV_get_wargoal_on_THIS()
      $OVERLORD->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($JAP) + $opinion_factor($OVERLORD)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $JAP->is_friend_of_PREV()
          $OVERLORD->is_friend_of_PREV()

  focus[id = MAN_imperial_divinity]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAN_imperial_university]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAN_move_capitals]:
