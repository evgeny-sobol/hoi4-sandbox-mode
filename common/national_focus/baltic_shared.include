  shared_focus[id = BALTIC_end_bourgeouis_dictatorships]:
    available:
      $LIT->can_PREV_get_wargoal_on_THIS()
      $LAT->can_PREV_get_wargoal_on_THIS()
      $EST->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($LIT) + $opinion_factor($LAT) + $opinion_factor($EST)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $LIT->is_friend_of_PREV()
          $LAT->is_friend_of_PREV()
          $EST->is_friend_of_PREV()

