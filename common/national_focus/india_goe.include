  focus[id = RAJ_deathblow_to_imperial_remnants]:
    available:
      $PAK->can_PREV_get_wargoal_on_THIS()
      $BRM->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($PAK) + $opinion_factor($BRM)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $PAK->is_friend_of_PREV()
          $BRM->is_friend_of_PREV()

  focus[id = RAJ_stopping_the_japanese_threat_into_central_asia]:
    available:
      $JAP->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($JAP)
      +modifier:
        $ai_betrayal_modifier_vs($JAP)

