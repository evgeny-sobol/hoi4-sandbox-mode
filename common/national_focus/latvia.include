  focus[id = LAT_lightning_strike]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $LIT->is_friend_of_PREV(no)
          $EST->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($LIT) + $opinion_factor($EST)) / 2
        factor(antagonism)
        is_sandbox_mode_on()

