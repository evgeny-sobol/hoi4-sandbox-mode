  focus[id = LAT_anti_german_propaganda]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        f = (mtth:fascism_factor) / (2 * mtth:fascism_factor + 2 * mtth:democracy_factor) * 3
        factor(f)
        is_sandbox_mode_on()

  focus[id = LAT_alignment_with_germany]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        f = (mtth:democracy_factor + mtth:fascism_factor) / (2 * mtth:fascism_factor + 2 * mtth:democracy_factor) * 3
        factor(f)
        is_sandbox_mode_on()

  focus[id = LAT_the_thunder_strikes_alone]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
