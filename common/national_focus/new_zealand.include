  focus[id = NZL_strengthen_the_commonwealth]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $ENG->is_friend_of_PREV(no)
          $NZL->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($NZL)) / 2
        factor(antagonism)
        is_sandbox_mode_on()

