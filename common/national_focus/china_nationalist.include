  focus[id = CHI_prioritize_the_interior]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = CHI_united_front]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = CHI_pick_a_fight_with_japan]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $MAN->is_friend_of_PREV(no)
          $JAP->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($MAN) + $opinion_factor($JAP)) / 2
        factor(antagonism)
        is_sandbox_mode_on()

  focus[id = CHI_anti_communism]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $SIK->is_friend_of_PREV(no)
          $TIB->is_friend_of_PREV(no)
          $PRC->is_friend_of_PREV(no)
          $YUN->is_friend_of_PREV(no)
          $SHX->is_friend_of_PREV(no)
          $GXC->is_friend_of_PREV(no)
          $XSM->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SIK) + $opinion_factor($TIB) + $opinion_factor($PRC) + $opinion_factor($YUN) + $opinion_factor($SHX) + $opinion_factor($GXC) + $opinion_factor($XSM)) / 7
        factor(antagonism)
        is_sandbox_mode_on()

  focus[id = CHI_subjugate_the_warlords]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

