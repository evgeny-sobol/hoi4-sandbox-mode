  focus[id = SWE_strike_the_capitalist_beast_down]:
    available:
      $GER->can_PREV_get_wargoal_on_THIS()
      $SOV->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($GER) + $opinion_factor($SOV)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($GER, $SOV)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $GER->is_friend_of_PREV()
          $SOV->is_friend_of_PREV()

