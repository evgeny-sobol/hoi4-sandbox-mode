  focus[id = SWE_the_nordic_defense_council]:
    available:
      $NOR->can_PREV_get_wargoal_on_THIS()
      $SWE->can_PREV_get_wargoal_on_THIS()
      $DEN->can_PREV_get_wargoal_on_THIS()
      $FIN->can_PREV_get_wargoal_on_THIS()
      $ICE->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 1 + mtth:democracy_factor
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($NOR) + $opinion_factor($SWE) + $opinion_factor($DEN) + $opinion_factor($FIN) + $opinion_factor($ICE)) / 5
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($NOR)
        $rivalry_vs_into($SWE)
        $rivalry_vs_into($DEN)
        $rivalry_vs_into($FIN)
        $rivalry_vs_into($ICE)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $NOR->is_friend_of_PREV()
          $SWE->is_friend_of_PREV()
          $DEN->is_friend_of_PREV()
          $FIN->is_friend_of_PREV()
          $ICE->is_friend_of_PREV()

