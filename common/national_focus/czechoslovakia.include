  focus[id = CZE_german_minor_ally]:
    available:
      $CZE->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:fascism_factor) / (2 * mtth:fascism_factor) * 3
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($CZE)
      +modifier:
        $ai_betrayal_modifier_vs($CZE)

