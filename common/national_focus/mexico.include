  focus[id = MEX_focus_march_southwards]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $GUA->is_friend_of_PREV(no)
          $HON->is_friend_of_PREV(no)
          $ELS->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($GUA) + $opinion_factor($HON) + $opinion_factor($ELS)) / 3
        factor(antagonism)
        is_sandbox_mode_on()

