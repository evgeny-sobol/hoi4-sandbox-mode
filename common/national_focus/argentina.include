  focus[id = ARG_british_gaurantee]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
      $ARG->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:democracy_factor) / (2 * mtth:democracy_factor) * 3
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($ARG)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $ARG->is_friend_of_PREV()

