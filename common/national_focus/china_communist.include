focus_tree[id = china_communist_focus]:
  focus[id = PRC_strengthen_the_central_secretariat]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()

  focus[id = PRC_marxist_orthodoxy]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        f = (mtth:communism_factor) / (2 * mtth:communism_factor) * 3
        factor(f)
        is_sandbox_mode_on()

