  focus[id = PRC_exploit_the_weak_neighbours]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $SHX->is_friend_of_PREV(no)
          $XSM->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SHX) + $opinion_factor($XSM)) / 2
        factor(antagonism)
        is_sandbox_mode_on()

