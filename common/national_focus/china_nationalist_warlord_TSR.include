  focus[id = CHI_sea_anti_communism]:
    available:
      $SIK->can_PREV_get_wargoal_on_THIS()
      $TIB->can_PREV_get_wargoal_on_THIS()
      $PRC->can_PREV_get_wargoal_on_THIS()
      $YUN->can_PREV_get_wargoal_on_THIS()
      $SHX->can_PREV_get_wargoal_on_THIS()
      $HBC->can_PREV_get_wargoal_on_THIS()
      $GXC->can_PREV_get_wargoal_on_THIS()
      $XSM->can_PREV_get_wargoal_on_THIS()
      $SND->can_PREV_get_wargoal_on_THIS()
      $GDC->can_PREV_get_wargoal_on_THIS()
      $SIC->can_PREV_get_wargoal_on_THIS()
      $XIC->can_PREV_get_wargoal_on_THIS()
      $NXM->can_PREV_get_wargoal_on_THIS()
      $GSM->can_PREV_get_wargoal_on_THIS()
      $KHM->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SIK) + $opinion_factor($TIB) + $opinion_factor($PRC) + $opinion_factor($YUN) + $opinion_factor($SHX) + $opinion_factor($HBC) + $opinion_factor($GXC) + $opinion_factor($XSM) + $opinion_factor($SND) + $opinion_factor($GDC) + $opinion_factor($SIC) + $opinion_factor($XIC) + $opinion_factor($NXM) + $opinion_factor($GSM) + $opinion_factor($KHM)) / 15
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($SIK)
        $rivalry_vs_into($TIB)
        $rivalry_vs_into($PRC)
        $rivalry_vs_into($YUN)
        $rivalry_vs_into($SHX)
        $rivalry_vs_into($HBC)
        $rivalry_vs_into($GXC)
        $rivalry_vs_into($XSM)
        $rivalry_vs_into($SND)
        $rivalry_vs_into($GDC)
        $rivalry_vs_into($SIC)
        $rivalry_vs_into($XIC)
        $rivalry_vs_into($NXM)
        $rivalry_vs_into($GSM)
        $rivalry_vs_into($KHM)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $SIK->is_friend_of_PREV()
          $TIB->is_friend_of_PREV()
          $PRC->is_friend_of_PREV()
          $YUN->is_friend_of_PREV()
          $SHX->is_friend_of_PREV()
          $HBC->is_friend_of_PREV()
          $GXC->is_friend_of_PREV()
          $XSM->is_friend_of_PREV()
          $SND->is_friend_of_PREV()
          $GDC->is_friend_of_PREV()
          $SIC->is_friend_of_PREV()
          $XIC->is_friend_of_PREV()
          $NXM->is_friend_of_PREV()
          $GSM->is_friend_of_PREV()
          $KHM->is_friend_of_PREV()

  focus[id = CHI_sea_pick_a_fight_with_japan]:
    available:
      $MAN->can_PREV_get_wargoal_on_THIS()
      $JAP->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($MAN) + $opinion_factor($JAP)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($MAN, $JAP)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $MAN->is_friend_of_PREV()
          $JAP->is_friend_of_PREV()

