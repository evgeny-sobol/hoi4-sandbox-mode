  focus[id = INS_destroy_pacific_colonialism]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
      $MAL->can_PREV_get_wargoal_on_THIS()
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($MAL)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $MAL->is_friend_of_PREV()

