focus_tree[id = philippines_focus]:
  focus[id = PHI_commonwealth_of_the_philippines]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()

  focus[id = PHI_align_with_the_usa]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)

  focus[id = PHI_align_with_japan]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)

  focus[id = PHI_peg_the_peso_to_the_dollar]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)

  focus[id = PHI_leverage_the_peso]:
    available:
      $PHI->can_PREV_get_wargoal_on_THIS()
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)
      modifier:
        $ai_war_support_modifier()
      modifier:
        $ai_antagonism_modifier($PHI)
      modifier:
        $ai_rivalry_modifier($PHI)
      modifier:
        $ai_betrayal_modifier_vs($PHI)

  focus[id = PHI_quezon_city]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = PHI_unicameral_legislature]:
    +ai_will_do:
