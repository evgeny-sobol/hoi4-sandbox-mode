  focus[id = PHI_agricultural_migrants_to_hawaii]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = PHI_encourage_foreign_investment]:
    available:
      $JAP->can_PREV_get_wargoal_on_THIS()
      $PHI->can_PREV_get_wargoal_on_THIS()
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($JAP) + $opinion_factor($PHI)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        $ai_rivalry_modifier_max($JAP, $PHI)
      modifier:
        $ai_betrayal_modifier()
        or:
          $JAP->is_friend_of_PREV()
          $PHI->is_friend_of_PREV()

