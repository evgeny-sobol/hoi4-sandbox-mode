  shared_focus[id = CHI_guidance_and_support]:
    available:
      $VIN->can_PREV_get_wargoal_on_THIS()
      $CAM->can_PREV_get_wargoal_on_THIS()
      $LAO->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($VIN) + $opinion_factor($CAM) + $opinion_factor($LAO)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $VIN->is_friend_of_PREV()
          $CAM->is_friend_of_PREV()
          $LAO->is_friend_of_PREV()

