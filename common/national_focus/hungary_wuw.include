focus_tree[id = wuw_hungarian_focus]:
  focus[id = wuw_HUN_end_the_regency]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        f = (mtth:communism_factor) / (2 * mtth:communism_factor + mtth:democracy_factor + 2 * mtth:monarchy_factor + mtth:fascism_factor) * 3
        factor(f)
        is_sandbox_mode_on()

