      +modifier:
        $ai_betrayal_modifier_vs($GRE)

  focus[id = GRE_tow_the_stalinist_line]:
    available:
      $TUR->can_PREV_get_wargoal_on_THIS()
      $GRE->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($TUR) + $opinion_factor($GRE)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($TUR, $GRE)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $TUR->is_friend_of_PREV()
          $GRE->is_friend_of_PREV()

