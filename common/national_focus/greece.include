  focus[id = GRE_prepare_for_the_great_anti_fascist_war]:
    available:
      $GRE->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
