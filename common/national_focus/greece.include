  focus[id = GRE_attack_the_fascists]:
    available:
      $ITA->can_PREV_get_wargoal_on_THIS()
      $GER->can_PREV_get_wargoal_on_THIS()
      $HUN->can_PREV_get_wargoal_on_THIS()
      $YUG->can_PREV_get_wargoal_on_THIS()
      $ROM->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ITA) + $opinion_factor($GER) + $opinion_factor($HUN) + $opinion_factor($YUG) + $opinion_factor($ROM)) / 5
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($ITA)
        $rivalry_vs_into($GER)
        $rivalry_vs_into($HUN)
        $rivalry_vs_into($YUG)
        $rivalry_vs_into($ROM)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ITA->is_friend_of_PREV()
          $GER->is_friend_of_PREV()
          $HUN->is_friend_of_PREV()
          $YUG->is_friend_of_PREV()
          $ROM->is_friend_of_PREV()

