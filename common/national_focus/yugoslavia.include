        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($SLV)
      +modifier:
        $ai_rivalry_modifier($SLV)
      +modifier:
        $ai_betrayal_modifier_vs($SLV)

  focus[id = YUG_united_autonomous_croatia]:
    available:
