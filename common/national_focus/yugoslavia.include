      +modifier:
        $ai_rivalry_modifier($BOS)
      +modifier:
        $ai_betrayal_modifier_vs($BOS)

  focus[id = YUG_divide_bosnia]:
    available:
      $HRZ->can_PREV_get_wargoal_on_THIS()
      $BOS->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($HRZ) + $opinion_factor($BOS)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($HRZ, $BOS)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $HRZ->is_friend_of_PREV()
          $BOS->is_friend_of_PREV()

  focus[id = YUG_dissolve_serbia]:
    available:
      $MAC->can_PREV_get_wargoal_on_THIS()
      $KOS->can_PREV_get_wargoal_on_THIS()
      $MNT->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($MAC) + $opinion_factor($KOS) + $opinion_factor($MNT)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($MAC)
        $rivalry_vs_into($KOS)
        $rivalry_vs_into($MNT)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $MAC->is_friend_of_PREV()
          $KOS->is_friend_of_PREV()
          $MNT->is_friend_of_PREV()

