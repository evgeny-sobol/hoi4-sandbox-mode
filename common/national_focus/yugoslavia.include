focus_tree[id = yugoslavian_focus]:
  focus[id = YUG_western_focus]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
  focus[id = YUG_friendship_treaty_with_italy]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
  focus[id = YUG_reinforce_old_alliances]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
      $FRA->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($FRA)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($ENG, $FRA)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $FRA->is_friend_of_PREV()

  focus[id = YUG_attract_allied_capital]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = YUG_attract_axis_capital]:
