  focus[id = COG_liberation_by_force]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
      $POR->can_PREV_get_wargoal_on_THIS()
      $FRA->can_PREV_get_wargoal_on_THIS()
      $SPR->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = (mtth:communism_factor) / (2 * mtth:communism_factor) * 2
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($POR) + $opinion_factor($FRA) + $opinion_factor($SPR)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $POR->is_friend_of_PREV()
          $FRA->is_friend_of_PREV()
          $SPR->is_friend_of_PREV()

