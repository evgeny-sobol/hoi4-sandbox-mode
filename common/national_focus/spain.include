          $CHL->is_friend_of_PREV(no)
          $PRU->is_friend_of_PREV(no)
          $VEN->is_friend_of_PREV(no)
          $COL->is_friend_of_PREV(no)
          $BOL->is_friend_of_PREV(no)
          $MEX->is_friend_of_PREV(no)
          $USA->is_friend_of_PREV(no)
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($ARG) + $opinion_factor($CHL) + $opinion_factor($PRU) + $opinion_factor($VEN) + $opinion_factor($COL) + $opinion_factor($BOL) + $opinion_factor($MEX) + $opinion_factor($USA)) / 8
        factor(antagonism)
        is_sandbox_mode_on()

