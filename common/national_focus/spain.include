  focus[id = SPA_unite_iberia]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $POR->is_friend_of_PREV(no)
          $ENG->is_friend_of_PREV(no)
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($POR) + $opinion_factor($ENG)) / 2
        factor(antagonism)
        is_sandbox_mode_on()

  focus[id = SPA_absorb_the_portuguese_empire]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $BRA->is_friend_of_PREV(no)
          $MZB->is_friend_of_PREV(no)
          $ANG->is_friend_of_PREV(no)
          $GNB->is_friend_of_PREV(no)
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($BRA) + $opinion_factor($MZB) + $opinion_factor($ANG) + $opinion_factor($GNB)) / 4
        factor(antagonism)
        is_sandbox_mode_on()

  focus[id = SPA_claim_the_aragonese_possessions]:
    available:
      $ITA->can_PREV_get_wargoal_on_THIS()
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
