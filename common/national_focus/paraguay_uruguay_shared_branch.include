  shared_focus[id = GUAY_rekindle_old_gripes]:
    available:
      $BRA->can_PREV_get_wargoal_on_THIS()
      $ARG->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($BRA) + $opinion_factor($ARG)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($BRA)
        $rivalry_vs_into($ARG)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $BRA->is_friend_of_PREV()
          $ARG->is_friend_of_PREV()

