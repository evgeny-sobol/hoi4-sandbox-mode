focus_tree[id = british_focus]:
# ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀█
# █  ▄ █▀▀▄ █   █  ▀▀▄  ▀▀▄ █▀▀▄ █   █ █▀▀█ █  █       █
#  ▀▀  ▀  ▀  ▀▀▀  ▀▀▀  ▀▀▀  ▀  ▀  ▀▀▀  ▀  ▀ ▀▀▀        ▀
  focus[id = uk_empire_focus]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = 1 + mtth:monarchy_factor + mtth:fascism_factor - mtth:communism_factor
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        factor(0)
        has_completed_focus(ENG_concessions_to_the_trade_unions)
        is_sandbox_mode_on()

  focus[id = ENG_revisit_colonial_policy]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        f = 1 + mtth:communism_factor - mtth:monarchy_factor - mtth:fascism_factor
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        factor(0)
        has_completed_focus(ENG_organize_the_blackshirts)
        is_sandbox_mode_on()

# ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀▀▀▄
