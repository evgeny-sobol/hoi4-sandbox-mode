  focus[id = ENG_the_kings_party]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = mtth:monarchy_factor /
          (mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = ENG_organize_the_blackshirts]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = mtth:fascism_factor /
          (mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = ENG_concessions_to_the_trade_unions]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = mtth:communism_factor /
          (mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

