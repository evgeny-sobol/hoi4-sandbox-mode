  focus[id = ENG_steady_as_she_goes]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        f = mtth:democracy_factor
        factor(f)
        is_sandbox_mode_on()

  focus[id = ENG_a_change_in_course]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        f = mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor
        factor(f)
        is_sandbox_mode_on()

# ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀▀▀▄
