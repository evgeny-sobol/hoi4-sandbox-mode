  focus[id = CHL_secure_the_brazilian_border]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $PAR->is_friend_of_PREV(no)
          $BOL->is_friend_of_PREV(no)
          $URG->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($PAR) + $opinion_factor($BOL) + $opinion_factor($URG)) / 3
        factor(antagonism)
        is_sandbox_mode_on()

