  focus[id = CHL_taking_back_patagonia]:
    available:
      +or:
        is_honored_leader(no)
        and:
          var:CHL_taking_back_patagonia_targets[0]->is_friend_of_PREV(no)
          var:CHL_taking_back_patagonia_targets[1]->is_friend_of_PREV(no)
          var:CHL_taking_back_patagonia_targets[2]->is_friend_of_PREV(no)
          var:CHL_taking_back_patagonia_targets[3]->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        factor(CHL_taking_back_patagonia_antagonism)
        is_sandbox_mode_on()

