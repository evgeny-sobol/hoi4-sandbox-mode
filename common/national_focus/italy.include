      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($FRA) +
          $opinion_factor($BEL) + $opinion_factor($POR) + $opinion_factor($SPA)) / 5
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $FRA->is_friend_of_PREV()
          $BEL->is_friend_of_PREV()
          $POR->is_friend_of_PREV()
          and:
            country_exists($SPA)
