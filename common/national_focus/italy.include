  focus[id = ITA_solid_progress]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()

  focus[id = ITA_the_abyssinian_fiasco]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()
      modifier:
        f = (mtth:democracy_factor + mtth:communism_factor) * 3
        factor(f)
        is_sandbox_mode_on()

  focus[id = ITA_struggle_in_ethiopia]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()
      modifier:
        f = (mtth:monarchy_factor + mtth:fascism_factor) * 3
        factor(f)
        is_sandbox_mode_on()

