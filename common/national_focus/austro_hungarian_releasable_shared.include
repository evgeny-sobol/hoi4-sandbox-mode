  focus[id = ah_collectivist_ethos]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:communism_factor + mtth:fascism_factor + mtth:monarchy_factor) / (mtth:communism_factor + mtth:fascism_factor + 2 * mtth:monarchy_factor + mtth:democracy_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = ah_nationalism_focus]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:fascism_factor + mtth:monarchy_factor) / (mtth:fascism_factor + 2 * mtth:monarchy_factor + mtth:communism_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = ah_internationalism_focus]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:communism_factor + mtth:monarchy_factor) / (mtth:fascism_factor + 2 * mtth:monarchy_factor + mtth:communism_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = ah_liberty_ethos]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:democracy_factor + mtth:monarchy_factor) / (mtth:communism_factor + mtth:fascism_factor + 2 * mtth:monarchy_factor + mtth:democracy_factor) * 2
        factor(f)
        is_sandbox_mode_on()

