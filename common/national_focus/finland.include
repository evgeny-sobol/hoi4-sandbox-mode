  focus[id = FIN_join_the_comintern]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:communism_factor) / (2 * mtth:communism_factor + 2 * mtth:democracy_factor) * 3
        factor(f)
        is_sandbox_mode_on()

  focus[id = FIN_united_under_the_north_star]:
    available:
      $SWE->can_PREV_get_wargoal_on_THIS()
      $NOR->can_PREV_get_wargoal_on_THIS()
      $DEN->can_PREV_get_wargoal_on_THIS()
      $ICE->can_PREV_get_wargoal_on_THIS()
      $SMI->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:communism_factor + mtth:democracy_factor) / (2 * mtth:communism_factor + 2 * mtth:democracy_factor) * 3
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SWE) + $opinion_factor($NOR) + $opinion_factor($DEN) + $opinion_factor($ICE) + $opinion_factor($SMI)) / 5
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $SWE->is_friend_of_PREV()
          $NOR->is_friend_of_PREV()
          $DEN->is_friend_of_PREV()
          $ICE->is_friend_of_PREV()
          $SMI->is_friend_of_PREV()

  focus[id = FIN_approach_major_democracies]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:democracy_factor) / (2 * mtth:communism_factor + 2 * mtth:democracy_factor) * 3
        factor(f)
        is_sandbox_mode_on()

