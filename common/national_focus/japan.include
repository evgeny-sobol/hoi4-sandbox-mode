focus_tree[id = japan_wtt_focus]:
#      TABLE OF CONTENTS
#I.    Crossroad 1
#II.   Military Purge
#III.  Communists
#IV.   Democrats
#V.    Monarchists
#VI.   Monarchists or Fascists
#VII.  Fascists
#VIII. Economy
#IX.   Military
#X.    Hasn't "No Compromise, No Surrender"
#XI.   Everything else

#I. ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀█
#   █  ▄ █▀▀▄ █   █  ▀▀▄  ▀▀▄ █▀▀▄ █   █ █▀▀█ █  █       █
#    ▀▀  ▀  ▀  ▀▀▀  ▀▀▀  ▀▀▀  ▀  ▀  ▀▀▀  ▀  ▀ ▀▀▀        ▀
  focus[id = JAP_okadas_military_purge_speech]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_high_tyranny_tilt()
      +modifier:
        $root_modifier()
      +modifier:
        f = (mtth:democracy_factor + mtth:communism_factor) /
          (mtth:democracy_factor + 2 * mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor) * 3
        factor(f)
        is_sandbox_mode_on()
    completion_reward:
      $add_tyranny(20)
    available:
      is_liberal_leader(no)

  focus[id = JAP_revere_the_emperor_destroy_the_traitors]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        f = mtth:monarchy_factor /
          (mtth:democracy_factor + 2 * mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor) * 3
        factor(f)
        is_sandbox_mode_on()

  focus[id = JAP_sea_purge_the_kodoha_faction]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_high_tyranny_tilt()
      +modifier:
        $root_modifier()
      +modifier:
        f = (mtth:monarchy_factor + mtth:fascism_factor) /
          (mtth:democracy_factor + 2 * mtth:monarchy_factor + mtth:communism_factor + mtth:fascism_factor) * 3
        factor(f)
        is_sandbox_mode_on()

