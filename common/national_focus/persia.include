  focus[id = PER_persian_german_trade]:
    available:
      $PER->can_PREV_get_wargoal_on_THIS()
      $GER->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($PER) + $opinion_factor($GER)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $PER->is_friend_of_PREV()
          $GER->is_friend_of_PREV()

