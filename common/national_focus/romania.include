focus_tree[id = romanian_focus]:
  focus[id = ROM_preserve_greater_romania]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = ROM_a_deal_with_the_devil]:
    available:
      $SOV->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($SOV)
      +modifier:
        $ai_betrayal_modifier_vs($SOV)

