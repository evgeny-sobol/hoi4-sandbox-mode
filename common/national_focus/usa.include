  focus[id = USA_us_ussr_economic_cooperation]:
    available:
      $SOV->is_rival_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_cooperation_modifier($SOV)
      +modifier:
        factor(0)
        $SOV in rivals[]
        is_sandbox_mode_on()

  focus[id = USA_unholy_alliance]:
    available:
      $SOV->is_rival_of_PREV(no)
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $crossroad_modifier(2)
      modifier:
        #TODO
        cooperation = $opinion_factor($SOV) /
          ($opinion_factor($SOV) + $opinion_factor($PRC))
        factor(cooperation)
        is_sandbox_mode_on()
      modifier:
        factor(0)
        $SOV in rivals[]
        is_sandbox_mode_on()

  focus[id = USA_secure_china]:
    available:
      $PRC->is_rival_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        #TODO
        cooperation = $opinion_factor($PRC) /
          ($opinion_factor($SOV) + $opinion_factor($PRC))
        factor(cooperation)
        is_sandbox_mode_on()
      +modifier:
        factor(0)
        $PRC in rivals[]
        is_sandbox_mode_on()

  #TODO
  focus[id = USA_end_monarchism]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
      $GER->can_PREV_get_wargoal_on_THIS()
      $HUN->can_PREV_get_wargoal_on_THIS()
      $JAP->can_PREV_get_wargoal_on_THIS()
      $MAN->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($GER) +
          $opinion_factor($HUN) +
          $opinion_factor($JAP) +
          $opinion_factor($MAN)) / 5
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($ENG)
        $rivalry_vs_into($GER)
        $rivalry_vs_into($HUN)
        $rivalry_vs_into($JAP)
        $rivalry_vs_into($MAN)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $GER->is_friend_of_PREV()
          $HUN->is_friend_of_PREV()
          $JAP->is_friend_of_PREV()
          $MAN->is_friend_of_PREV()

  #TODO
  focus[id = USA_shatter_the_empires]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

