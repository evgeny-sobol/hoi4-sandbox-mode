focus_tree[id = usa_focus]:
# ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀█
# █  ▄ █▀▀▄ █   █  ▀▀▄  ▀▀▄ █▀▀▄ █   █ █▀▀█ █  █       █
#  ▀▀  ▀  ▀  ▀▀▀  ▀▀▀  ▀▀▀  ▀  ▀  ▀▀▀  ▀  ▀ ▀▀▀        ▀
  focus[id = USA_continue_the_new_deal]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        f = 2 * (mtth:democracy_factor + mtth:communism_factor) /
          (2 * mtth:democracy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = USA_reestablish_the_gold_standard]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        f = 2 * (mtth:democracy_factor + mtth:fascism_factor) /
          (2 * mtth:democracy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

# ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀▀▀▄
# █  ▄ █▀▀▄ █   █  ▀▀▄  ▀▀▄ █▀▀▄ █   █ █▀▀█ █  █      ▄▀▀ 
#  ▀▀  ▀  ▀  ▀▀▀  ▀▀▀  ▀▀▀  ▀  ▀  ▀▀▀  ▀  ▀ ▀▀▀       ▀▀▀▀
  focus[id = USA_limited_intervention]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = USA_neutrality_act]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = USA_suspend_the_presecution]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 1 + mtth:communism_factor
        factor(f)

  focus[id = USA_union_representation_act]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 4 * mtth:communism_factor /
          (mtth:democracy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = USA_america_first]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 1 + mtth:fascism_factor
        factor(f)

  focus[id = USA_ally_with_the_silver_shirts]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 4 * mtth:fascism_factor /
          (mtth:democracy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

