        $ai_sandbox_modifier()

  #TODO
  focus[id = USA_liberty_for_the_philippines]:
    available:
      $not_rival_of_PREV($PHI)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_cooperation_modifier($PHI)
      +modifier:
        factor(0)
        $PHI in rivals[]
        is_sandbox_mode_on()

  focus[id = USA_pacific_decolonisation]:
    available:
      var:USA_pacific_decolonisation_targets[0]->can_PREV_get_wargoal_on_THIS()
      var:USA_pacific_decolonisation_targets[1]->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        factor(USA_pacific_decolonisation_antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        any_other_country:
          THIS in ROOT.USA_pacific_decolonisation_targets[]
          is_friend_of_ROOT()

