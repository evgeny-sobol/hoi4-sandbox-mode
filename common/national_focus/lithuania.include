  focus[id = LIT_appease_soviets]:
    available:
      $can_get_wargoal_on($SOU)
      $LIT->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SOU) + $opinion_factor($LIT)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          and:
            country_exists($SOU)
            $SOU->is_friend_of_PREV()
          $LIT->is_friend_of_PREV()

