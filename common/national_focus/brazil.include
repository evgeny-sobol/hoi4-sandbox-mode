  focus[id = BRA_guyana_crisis]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
      $FRA->can_PREV_get_wargoal_on_THIS()
      $HOL->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($FRA) + $opinion_factor($HOL)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $FRA->is_friend_of_PREV()
          $HOL->is_friend_of_PREV()

