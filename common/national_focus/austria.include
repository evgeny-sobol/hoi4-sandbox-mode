focus_tree[id = austria_focus_tree]:
  focus[id = AUS_repeal_the_may_constitution]:
    available:
      $GER->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($GER)
      +modifier:
        $ai_rivalry_modifier($GER)
      +modifier:
        $ai_betrayal_modifier_vs($GER)

  focus[id = AUS_release_imprisoned_leaders]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = AUS_austria_against_fascism]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = AUS_austromarxism_focus]:
