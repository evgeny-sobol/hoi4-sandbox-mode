  focus[id = AUS_approach_democratic_guarantors]:
    available:
      $FRA->can_PREV_get_wargoal_on_THIS()
      $ENG->can_PREV_get_wargoal_on_THIS()
      $USA->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($FRA) + $opinion_factor($ENG) + $opinion_factor($USA)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($FRA)
        $rivalry_vs_into($ENG)
        $rivalry_vs_into($USA)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $FRA->is_friend_of_PREV()
          $ENG->is_friend_of_PREV()
          $USA->is_friend_of_PREV()

