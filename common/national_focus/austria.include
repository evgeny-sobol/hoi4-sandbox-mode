  focus[id = AUS_intervention_in_spain]:
    available:
      $can_get_wargoal_on($SPD)
      $SPR->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SPD) + $opinion_factor($SPR)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($SPD, $SPR)
      +modifier:
        $ai_betrayal_modifier()
        or:
          and:
            country_exists($SPD)
            $SPD->is_friend_of_PREV()
          $SPR->is_friend_of_PREV()

  focus[id = AUS_invite_spanish_exiles]:
    available:
      $can_get_wargoal_on($SPA)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:communism_factor + mtth:democracy_factor) / (2 * mtth:communism_factor + 2 * mtth:democracy_factor) * 2
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($SPA)
      +modifier:
        $ai_rivalry_modifier($SPA)
      +modifier:
        $ai_betrayal_modifier_vs($SPA)
      +modifier:
        $ai_mic_modifier()

  focus[id = AUS_celebrate_spanish_victory]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:communism_factor + mtth:democracy_factor) / (2 * mtth:communism_factor + 2 * mtth:democracy_factor) * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = AUS_revolution]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_civil_war_ignition_modifier()
      +modifier:
        factor(0)
        sandbox_civil_war_cap_reached()
    completion_reward:
      $sandbox_log_cw_ignition(AUS_revolution)

