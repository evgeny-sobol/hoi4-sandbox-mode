  focus[id = NOR_reawaken_the_permanent_revolution]:
    available:
      $SWE->can_PREV_get_wargoal_on_THIS()
      $FIN->can_PREV_get_wargoal_on_THIS()
      $DEN->can_PREV_get_wargoal_on_THIS()
      $ICE->can_PREV_get_wargoal_on_THIS()
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($SWE) + $opinion_factor($FIN) + $opinion_factor($DEN) + $opinion_factor($ICE)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        $ai_betrayal_modifier()
        or:
          $SWE->is_friend_of_PREV()
          $FIN->is_friend_of_PREV()
          $DEN->is_friend_of_PREV()
          $ICE->is_friend_of_PREV()

  focus[id = NOR_norwegian_engineering]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = NOR_crush_stalin]:
    available:
      $SOV->can_PREV_get_wargoal_on_THIS()
      $can_get_wargoal_on($SOB)
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($SOV) + $opinion_factor($SOB)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        $ai_betrayal_modifier()
        or:
          $SOV->is_friend_of_PREV()
          and:
            country_exists($SOB)
            $SOB->is_friend_of_PREV()
      modifier:
        $ai_mic_modifier()

