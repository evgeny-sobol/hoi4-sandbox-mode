      $FIN->can_PREV_get_wargoal_on_THIS()
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        $ai_antagonism_modifier($FIN)
      modifier:
        $ai_betrayal_modifier_vs($FIN)
      modifier:
        $ai_mic_modifier()

  focus[id = NOR_defend_finland]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_cooperation_modifier($FIN)

