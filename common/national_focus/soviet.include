  focus[id = SOV_eradicate_western_fascism]:
    available:
      $ENG->can_PREV_get_wargoal_on_THIS()
      $FRA->can_PREV_get_wargoal_on_THIS()
      $GER->can_PREV_get_wargoal_on_THIS()
      $ITA->can_PREV_get_wargoal_on_THIS()
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 1 - mtth:fascism_factor
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($FRA) +
          $opinion_factor($GER) +
          $opinion_factor($ITA)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($ENG)
        $rivalry_vs_into($FRA)
        $rivalry_vs_into($GER)
        $rivalry_vs_into($ITA)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $FRA->is_friend_of_PREV()
          $GER->is_friend_of_PREV()
          $ITA->is_friend_of_PREV()

  focus[id = SOV_approach_germany]:
    available:
      $not_rival_of_PREV($GER)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_cooperation_modifier($GER)
      +modifier:
        factor(0)
        $GER in rivals[]
        is_sandbox_mode_on()

