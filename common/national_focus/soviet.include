@HIGH_PRIORITY(2)
@LOW_PRIORITY(0.5)

focus_tree[id = soviet_focus]:
# ▄▀▀▄ █▀▀▄ ▄▀▀▀▄ ▄▀▀▀ ▄▀▀▀ █▀▀▄ ▄▀▀▀▄ ▄▀▀▄ █▀▀▄      ▀█
