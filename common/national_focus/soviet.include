@HIGH_ATTENTION(3)
@LOW_ATTENTION(0.33334)

focus_tree[id = soviet_focus]:

  focus[id = SOV_infrastructure_effort_nsb]:
    ai_will_do:
      +modifier:
        $basic_modifier()
      +modifier:
        factor(@HIGH_ATTENTION)
        not $compare(num_of_controlled_factories, "<", SOV_fyp_factory_requirement_tier_1)
        is_sandbox_mode_on()

