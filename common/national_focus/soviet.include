  focus[id = SOV_policy_of_collective_security]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:communism_factor + mtth:democracy_factor) /
          (2 * mtth:communism_factor + mtth:democracy_factor + mtth:fascism_factor) * 2
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        factor(0)
        has_civil_war()
        is_sandbox_mode_on()

  focus[id = SOV_policy_of_individual_security]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = (mtth:communism_factor + mtth:fascism_factor) /
          (2 * mtth:communism_factor + mtth:democracy_factor + mtth:fascism_factor) * 2
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        factor(0)
        or:
          has_civil_war()
          has_completed_focus(SOV_the_right_opposition)
        is_sandbox_mode_on()

