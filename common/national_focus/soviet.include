#  ▀▀  ▀  ▀  ▀▀▀  ▀▀▀  ▀▀▀  ▀  ▀  ▀▀▀  ▀  ▀ ▀▀▀        ▀
  focus[id = SOV_the_path_of_marxism_leninism]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()
      modifier:
        f = mtth:communism_factor * 2
        factor(f)
        is_sandbox_mode_on()

  focus[id = SOV_beaten_but_not_defeated]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        f = (mtth:democracy_factor + mtth:monarchy_factor + mtth:fascism_factor) * 2
        factor(f)
        is_sandbox_mode_on()

