#  ▀▀   ▀▀▀  ▀   ▀ ▀ ▀   ▀   ▀   ▀▀▀▀ ▀  ▀ ▀   ▀
  focus[id = SOV_the_comintern]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        factor(0)
        or:
          and:
            not has_completed_focus(SOV_the_centre)
            not has_completed_focus(SOV_the_left_opposition)
            not has_completed_focus(SOV_the_right_opposition)
          has_civil_war()
          and:
            has_completed_focus(SOV_the_left_opposition)
            not has_completed_focus(SOV_left_opposition_coup)
          and:
            has_completed_focus(SOV_the_right_opposition)
            not has_completed_focus(SOV_coup_detat)
        is_sandbox_mode_on()

  focus[id = SOV_development_aid_for_eastern_allies]:
    ai_will_do:
      +modifier:
