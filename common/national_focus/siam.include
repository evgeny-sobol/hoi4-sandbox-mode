  focus[id = SIA_retake_lost_british_states]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $ENG->is_friend_of_PREV(no)
          $BRM->is_friend_of_PREV(no)
          $MAL->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ENG) + $opinion_factor($BRM) + $opinion_factor($MAL)) / 3
        factor(antagonism)
        is_sandbox_mode_on()

  focus[id = SIA_recover_indochina]:
    available:
      +or:
        is_honored_leader(no)
        and:
          $FRA->is_friend_of_PREV(no)
          $VIC->is_friend_of_PREV(no)
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($FRA) + $opinion_factor($VIC)) / 2
        factor(antagonism)
        is_sandbox_mode_on()

