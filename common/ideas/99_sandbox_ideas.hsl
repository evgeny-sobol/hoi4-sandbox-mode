ideas:
  country:
    anti_democratic_sentiments:
      picture(neutrality_idea)
      allowed_civil_war:
        always()
      #on_add:
      #do_effect:
      modifier:
        democratic_drift(-0.01)
        democratic_acceptance(-10)
      #cancel:
      #on_remove:

    anti_monarchist_sentiments:
      picture(neutrality_idea)
      allowed_civil_war:
        always()
      modifier:
        neutrality_drift(-0.01)
        neutrality_acceptance(-10)

    anti_communist_sentiments:
      picture(neutrality_idea)
      allowed_civil_war:
        always()
      modifier:
        communism_drift(-0.01)
        communism_acceptance(-10)

    anti_fascist_sentiments:
      picture(neutrality_idea)
      allowed_civil_war:
        always()
      modifier:
        fascism_drift(-0.01)
        fascism_acceptance(-10)
