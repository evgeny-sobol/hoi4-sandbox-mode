major_rivals_scorer:
  targets:
    targets_dynamic(no)
    target_non_existing(no)
    target_array(global.majors)
    # FROM is the initiator, THIS is a target
    score:
      base(40)
      modifier:
        add(40)
        has_enemy_ideology_with_FROM()
        has_war_with_major(no)
      modifier:
        factor(0.5)
        has_government(FROM)
        has_war_with_major(no)
      modifier:
        factor(1_000)
        has_war_with(FROM)
      modifier:
        factor(0)
        FROM == THIS

minor_rivals_scorer:
  targets:
    targets_dynamic(no)
    target_non_existing(no)
    target_array(global.countries)
    # FROM is the initiator, THIS is a target
    score:
      base(40)
      modifier:
        add(40)
        is_puppet_of(FROM)
      modifier:
        add(40)
        is_subject_of(FROM)
      modifier:
        add(40)
        is_neighbor_of(FROM)
      modifier:
        factor(1.25)
        has_government(var:FROM.rival_ideology)
      modifier:
        factor(1_000)
        has_defensive_war_with(FROM)
      modifier:
        factor(0)
        not has_war_with(FROM)
        NOT:
          OR:
            is_on_same_continent_as(FROM)
            AND:
              OR:
                THIS.capital_scope::is_on_continent(north_america)
                THIS.capital_scope::is_on_continent(south_america)
              OR:
                FROM.capital_scope::is_on_continent(north_america)
                FROM.capital_scope::is_on_continent(south_america)
            AND:
              OR:
                THIS.capital_scope::is_on_continent(asia)
                THIS.capital_scope::is_on_continent(australia)
              OR:
                FROM.capital_scope::is_on_continent(asia)
                FROM.capital_scope::is_on_continent(australia)
            # $can_build_railway(THIS.capital, FROM.capital)
      modifier:
        factor(0)
        FROM == THIS
