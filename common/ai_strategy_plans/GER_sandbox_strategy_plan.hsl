GER_sandbox_strategy_plan_anschluss:
  allowed:
    original_tag($GER)
  enable:
    has_completed_focus(GER_remilitarize_the_rhineland)
    NOT:
      # Same threshold as GER_danzig_or_war available.
      $has_army_manpower(949999)
    is_sandbox_mode_on()
  abort_when_not_enabled()
  weight:
    factor(1)

  raw ai_national_focuses: {
    GER_anschluss
  }

  ai_strategy:
    type(force_build_armies)
    value(105)

  ai_strategy:
    type(build_army)
    id(infantry)
    value(105)
