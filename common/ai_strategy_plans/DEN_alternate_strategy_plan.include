DEN_rearmament_plan:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)

DEN_monarchist_plan:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)

DEN_fascist_plan:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)
