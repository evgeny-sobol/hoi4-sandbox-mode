NZL_alternate_democratic:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)

NZL_alternate_fascist:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)

NZL_alternate_communist:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)
