# Ultimatum 5 (LIT alone: variant A fields three targets).
country_event:
  id(sandbox_soviet_west.5)
  title(sandbox_soviet_west_5_t)
  desc(sandbox_soviet_west_5_d)
  picture(GFX_news_event_005)
