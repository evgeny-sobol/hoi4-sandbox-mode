# Peak phase: a top-2 open-pool candidate is offered a place in the bloc.
country_event:
  id(sandbox_soviet_west.4)
  title(sandbox_soviet_west_4_t)
  desc(sandbox_soviet_west_4_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(SOV)
  option:
    name(sandbox_soviet_west_4_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    give_military_access(SOV)
    SOV:
      give_military_access(PREV)
    $add_opinion_modifier(SOV, scenario_ally)
    $sandbox_log_sc(sc_join, soviet_west_joined)
  option:
    name(sandbox_soviet_west_4_b)
    ai_chance:
      factor(10)
