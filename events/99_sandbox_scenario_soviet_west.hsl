# docs/gdd/Scenarios Catalog.md: arc events for soviet_west.
add_namespace(sandbox_soviet_west)

# Crisis: provocation lands on the aggressor's desk.
country_event:
  id(sandbox_soviet_west.1)
  title(sandbox_soviet_west_1_t)
  desc(sandbox_soviet_west_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(SOV)
  option:
    name(sandbox_soviet_west_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, soviet_west_crisis)
    $sandbox_add_rivalry_vs(EST, 10)
    add_war_support(0.05)
  option:
    name(sandbox_soviet_west_1_b)
    ai_chance:
      factor(15)

# Ultimatum 2 (EST | POL).
country_event:
  id(sandbox_soviet_west.2)
  title(sandbox_soviet_west_2_t)
  desc(sandbox_soviet_west_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(EST | POL)
  option:
    name(sandbox_soviet_west_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    SOV:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, soviet_west_ult_2_submit)
  option:
    name(sandbox_soviet_west_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    SOV:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
      $create_wargoal(PREV, topple_government)
    $sandbox_log_sc(sc_crisis, soviet_west_ult_2_defy)

