# docs/gdd/Scenarios Catalog.md: arc events for napoleonic_france.
add_namespace(sandbox_napoleonic_france)

# Crisis: provocation lands on the aggressor's desk.
country_event:
  id(sandbox_napoleonic_france.1)
  title(sandbox_napoleonic_france_1_t)
  desc(sandbox_napoleonic_france_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(FRA)
  option:
    name(sandbox_napoleonic_france_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, napoleonic_france_crisis)
    $sandbox_add_rivalry_vs(BEL, 10)
    add_war_support(0.05)
  option:
    name(sandbox_napoleonic_france_1_b)
    ai_chance:
      factor(15)

# Ultimatum 2 (BEL).
country_event:
  id(sandbox_napoleonic_france.2)
  title(sandbox_napoleonic_france_2_t)
  desc(sandbox_napoleonic_france_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(BEL)
  option:
    name(sandbox_napoleonic_france_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    FRA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, napoleonic_france_ult_2_submit)
  option:
    name(sandbox_napoleonic_france_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    FRA:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
      $create_wargoal(PREV, topple_government)
    $sandbox_log_sc(sc_crisis, napoleonic_france_ult_2_defy)

