# Peak phase: a top-2 open-pool candidate is offered a place in the bloc.
country_event:
  id(sandbox_napoleonic_france.4)
  title(sandbox_napoleonic_france_4_t)
  desc(sandbox_napoleonic_france_4_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(FRA)
  option:
    name(sandbox_napoleonic_france_4_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    give_military_access(FRA)
    FRA:
      give_military_access(PREV)
    $add_opinion_modifier(FRA, scenario_ally)
    $sandbox_log_sc(sc_join, napoleonic_france_joined)
  option:
    name(sandbox_napoleonic_france_4_b)
    ai_chance:
      factor(10)
