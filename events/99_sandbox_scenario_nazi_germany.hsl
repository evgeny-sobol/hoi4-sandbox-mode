# docs/gdd/Scenarios Catalog.md: arc events for nazi_germany.
add_namespace(sandbox_nazi_germany)

# Crisis: provocation lands on the aggressor's desk.
country_event:
  id(sandbox_nazi_germany.1)
  title(sandbox_nazi_germany_1_t)
  desc(sandbox_nazi_germany_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(GER)
  option:
    name(sandbox_nazi_germany_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, nazi_germany_crisis)
    $sandbox_add_rivalry_vs(CZE, 10)
    add_war_support(0.05)
  option:
    name(sandbox_nazi_germany_1_b)
    ai_chance:
      factor(15)

# Ultimatum 2 (CZE | FRA).
country_event:
  id(sandbox_nazi_germany.2)
  title(sandbox_nazi_germany_2_t)
  desc(sandbox_nazi_germany_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(CZE | FRA)
  option:
    name(sandbox_nazi_germany_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    GER:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, nazi_germany_ult_2_submit)
  option:
    name(sandbox_nazi_germany_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    GER:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
    $sandbox_log_sc(sc_crisis, nazi_germany_ult_2_defy)

# Ultimatum 3 (POL | ENG).
country_event:
  id(sandbox_nazi_germany.3)
  title(sandbox_nazi_germany_3_t)
  desc(sandbox_nazi_germany_3_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(POL | ENG)
  option:
    name(sandbox_nazi_germany_3_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    GER:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, nazi_germany_ult_3_submit)
  option:
    name(sandbox_nazi_germany_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    GER:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
    $sandbox_log_sc(sc_crisis, nazi_germany_ult_3_defy)

# Peak phase: a top-2 open-pool candidate is offered a place in the bloc.
# The exit from any old faction is Honor-free (one-shot skip flag, like a
# released nation). No faction is created: see the note above.
country_event:
  id(sandbox_nazi_germany.4)
  title(sandbox_nazi_germany_4_t)
  desc(sandbox_nazi_germany_4_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(GER)
  option:
    name(sandbox_nazi_germany_4_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    give_military_access(GER)
    GER:
      give_military_access(PREV)
    $add_opinion_modifier(GER, scenario_ally)
    $sandbox_log_sc(sc_join, nazi_germany_joined)
  option:
    name(sandbox_nazi_germany_4_b)
    ai_chance:
      factor(10)
