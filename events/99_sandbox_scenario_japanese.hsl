# docs/gdd/Scenarios Catalog.md: arc events for japanese.
add_namespace(sandbox_japanese)

# Crisis: provocation lands on the aggressor's desk.
country_event:
  id(sandbox_japanese.1)
  title(sandbox_japanese_1_t)
  desc(sandbox_japanese_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(JAP)
  option:
    name(sandbox_japanese_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, japanese_crisis)
    $sandbox_add_rivalry_vs(CHI, 10)
    add_war_support(0.05)
  option:
    name(sandbox_japanese_1_b)
    ai_chance:
      factor(15)

# Ultimatum 2 (CHI | BRM).
country_event:
  id(sandbox_japanese.2)
  title(sandbox_japanese_2_t)
  desc(sandbox_japanese_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(CHI | BRM)
  option:
    name(sandbox_japanese_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    JAP:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, japanese_ult_2_submit)
  option:
    name(sandbox_japanese_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    JAP:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
    $sandbox_log_sc(sc_crisis, japanese_ult_2_defy)

