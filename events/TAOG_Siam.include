# Songsuradet war is a delayed country_event (siam.7 → siam.8), not a
# mission. Gate the existing if around start_civil_war and re-queue.
country_event[id = siam.8]:
  option[name = siam.8.a]:
    if:
      limit:
        sandbox_civil_war_ai_allowed()
    # Vanilla only starts the war when independent and not capitulated.
    # Do not re-queue a subject / fallen SIA forever.
    if sandbox_civil_war_ai_blocked() and not is_subject() and not has_capitulated():
      raw country_event: { id = siam.8 days = 7 }
      $sandbox_log_cw_defer(siam.8)
    if sandbox_civil_war_ai_allowed() and not is_subject() and not has_capitulated():
      $sandbox_log_cw_event(siam.8)
