# Pattern B: peaceful option .7.b stays (vanilla AI already prefers war).
country_event[id = LAT_events.7]:
  option[name = LAT_events.7.a]:
    ai_chance:
      +modifier:
        factor(0)
        sandbox_civil_war_cap_reached()
    $sandbox_log_cw_event(LAT_events.7.a)

# Both options start a war. Not fire_only_once. Mission `available` is also
# gated; this trigger catches a complete that slipped through.
country_event[id = LAT_events.8]:
  +trigger:
    sandbox_civil_war_ai_allowed()

