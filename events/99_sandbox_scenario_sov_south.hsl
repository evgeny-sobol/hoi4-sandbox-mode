# Peak phase: a top-2 open-pool candidate is offered a place in the bloc.
# The exit from any old faction is Honor-free (one-shot skip flag, like a
# released nation). No faction is created: see the note above.
country_event:
  id(sandbox_sov_south.5)
  title(sandbox_sov_south_5_t)
  desc(sandbox_sov_south_5_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(SOV)
  option:
    name(sandbox_sov_south_5_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    give_military_access(SOV)
    SOV:
      give_military_access(PREV)
    $add_opinion_modifier(SOV, scenario_ally)
    $sandbox_log_sc(sc_join, sov_south_joined)
  option:
    name(sandbox_sov_south_5_b)
    ai_chance:
      factor(10)
